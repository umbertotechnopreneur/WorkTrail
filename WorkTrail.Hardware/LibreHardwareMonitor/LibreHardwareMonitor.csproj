<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
    <AssemblyName>LibreHardwareMonitorLib</AssemblyName>
    <RootNamespace>LibreHardwareMonitor</RootNamespace>
    <Version>0.9.6</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <LhmSourceCache>$(MSBuildProjectDirectory)\obj\upstream</LhmSourceCache>
    <LhmSourceRoot>$(LhmSourceCache)\LibreHardwareMonitor-3d331e3370efb858411f19511373eff65a218701</LhmSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
    <PackageReference Include="DiskInfoToolkit" Version="1.1.2" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269" PrivateAssets="all" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>
  <Target Name="RestoreAuditedLibreHardwareMonitorSource" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Restore-LibreHardwareMonitorSource.ps1&quot; -Destination &quot;$(LhmSourceCache)&quot;" />
    <ItemGroup>
      <Compile Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\**\*.cs"
               Exclude="$(LhmSourceRoot)\LibreHardwareMonitorLib\Hardware\Memory\MemoryGroup.cs;$(LhmSourceRoot)\LibreHardwareMonitorLib\Hardware\Memory\DimmMemory.cs;$(LhmSourceRoot)\LibreHardwareMonitorLib\Hardware\Memory\Sensors\**\*.cs;$(LhmSourceRoot)\LibreHardwareMonitorLib\RAMSPDToolkitDriver.cs" />
      <Compile Include="MemoryGroup.cs" />
      <Compile Include="WorkTrailSensorAccess.cs" />
      <AdditionalFiles Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\NativeMethods.txt" />
      <EmbeddedResource Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\Resources\PawnIo\*.bin" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Update="$(LhmSourceRoot)\LibreHardwareMonitorLib\Resources\PawnIo\*.bin">
        <LogicalName>LibreHardwareMonitor.Resources.PawnIo.%(EmbeddedResource.Filename)%(EmbeddedResource.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
