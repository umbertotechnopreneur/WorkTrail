<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LhmSourceRoot>$(MSBuildProjectDirectory)\LibreHardwareMonitor\obj\upstream\LibreHardwareMonitor-3d331e3370efb858411f19511373eff65a218701</LhmSourceRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="obj\pawnio\PawnIO_setup.exe" Link="PawnIO\PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="PawnIO\distribution.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="PawnIO\NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RestorePawnIoInstaller" BeforeTargets="PrepareForBuild" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\scripts\Restore-PawnIoInstaller.ps1&quot; -Destination &quot;$(MSBuildProjectDirectory)\obj\pawnio&quot;" />
  </Target>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="LibreHardwareTelemetryCollector.cs" />
    <Compile Include="WindowsStorageTelemetryCollector.cs" />
    <Compile Include="WindowsVolumeSnapshotProjection.cs" />
    <ProjectReference Include="..\WorkTrail.Core\WorkTrail.Core.csproj" />
    <ProjectReference Include="LibreHardwareMonitor\LibreHardwareMonitor.csproj" />
    <Content Include="LibreHardwareMonitor\NOTICE.md" Link="HardwareLicenses\LibreHardwareMonitor-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LibreHardwareMonitor\MemoryGroup.cs" Link="HardwareLicenses\MemoryGroup.cs.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LibreHardwareMonitor\WorkTrailSensorAccess.cs" Link="HardwareLicenses\WorkTrailSensorAccess.cs.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\scripts\Restore-LibreHardwareMonitorSource.ps1" Link="HardwareLicenses\Restore-LibreHardwareMonitorSource.ps1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(LhmSourceRoot)\LICENSE" Link="HardwareLicenses\LibreHardwareMonitor-MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(LhmSourceRoot)\THIRD-PARTY-NOTICES.txt" Link="HardwareLicenses\LibreHardwareMonitor-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\PawnIo\PawnIo.cs" Link="HardwareLicenses\ModifiedSource\PawnIo.cs.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\Hardware\Sensor.cs" Link="HardwareLicenses\ModifiedSource\Sensor.cs.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\Hardware\Cpu\CpuGroup.cs" Link="HardwareLicenses\ModifiedSource\CpuGroup.cs.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(LhmSourceRoot)\LibreHardwareMonitorLib\Hardware\Gpu\NvidiaGpu.cs" Link="HardwareLicenses\ModifiedSource\NvidiaGpu.cs.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
