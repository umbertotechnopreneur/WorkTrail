<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WorkTrail.Controls.OptionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OptionsDividerColumn.Width" Value="1" />
                        <Setter Target="OptionsSecondaryColumn.Width" Value="*" />
                        <Setter Target="OptionsPrimaryPanel.Padding" Value="0,0,22,0" />
                        <Setter Target="OptionsSecondaryPanel.Padding" Value="22,0,0,0" />
                        <Setter Target="OptionsSecondaryPanel.(Grid.Row)" Value="0" />
                        <Setter Target="OptionsSecondaryPanel.(Grid.Column)" Value="2" />
                        <Setter Target="OptionsNarrowDivider.Visibility" Value="Collapsed" />
                        <Setter Target="OptionsWideDivider.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ApiKeyStates">
                <VisualState x:Name="ApiKeyNeedsAttention">
                    <VisualState.Setters>
                        <Setter Target="ApiKeyStatusIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ApiKeyReady">
                    <VisualState.Setters>
                        <Setter Target="ApiKeyStatusIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AiQuotaStates">
                <VisualState x:Name="AiQuotaAvailable">
                    <VisualState.Setters>
                        <Setter Target="AiQuotaPanel.BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="AiQuotaAccentBar.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="AiQuotaStateIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="AiQuotaStateIcon.Glyph" Value="&#xE73E;" />
                        <Setter Target="AiQuotaStateText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="AiQuotaProgressBar.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AiQuotaReached">
                    <VisualState.Setters>
                        <Setter Target="AiQuotaPanel.BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="AiQuotaAccentBar.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="AiQuotaStateIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="AiQuotaStateIcon.Glyph" Value="&#xE7BA;" />
                        <Setter Target="AiQuotaStateText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="AiQuotaProgressBar.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AiQuotaUnavailable">
                    <VisualState.Setters>
                        <Setter Target="AiQuotaPanel.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <Setter Target="AiQuotaAccentBar.Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="AiQuotaStateIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="AiQuotaStateIcon.Glyph" Value="&#xE946;" />
                        <Setter Target="AiQuotaStateText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="AiQuotaProgressBar.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppOptionsView">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Grid x:Name="OptionsColumnsGrid" Padding="0,0,18,18" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="OptionsPrimaryColumn" Width="*" />
                        <ColumnDefinition x:Name="OptionsDividerColumn" Width="0" />
                        <ColumnDefinition x:Name="OptionsSecondaryColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="OptionsPrimaryPanel" Grid.Row="0" Grid.Column="0" Spacing="0">
                    <StackPanel Spacing="8" Margin="0,0,0,20">
                        <TextBlock Tag="Labels.Title" Text="Labels" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Tag="Labels.Description"
                                   Text="Organize your activities by project or context with names, icons and colors."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Button Tag="Labels.Manage" Click="ManageLabels_Click" HorizontalAlignment="Left">
                            <TextBlock Tag="Labels.Manage" Text="Manage labels" TextWrapping="Wrap" />
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,0,0,20">
                        <ToggleSwitch x:Name="ShowAiMonthlySpendSwitch" Tag="Options.AiMonthlySpendVisibility" Header="Show monthly AI spend in the player" OffContent="Hidden" OnContent="Visible" />
                        <TextBlock Tag="Labels.CostHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,0,0,20">
                        <ComboBox
                            x:Name="LanguageBox"
                            Tag="Options.Language"
                            HorizontalAlignment="Stretch"
                            Header="Interface language"
                            AutomationProperties.Name="Interface language">
                            <ComboBoxItem Content="🌐 System" Tag="system" />
                            <ComboBoxItem Content="🇨🇳 Chinese (Simplified) · 简体中文" Tag="zh-Hans" />
                            <ComboBoxItem Content="🇺🇸 English (United States)" Tag="en-US" />
                            <ComboBoxItem Content="🇫🇷 French · Français" Tag="fr-FR" />
                            <ComboBoxItem Content="🇩🇪 German · Deutsch" Tag="de-DE" />
                            <ComboBoxItem Content="🇮🇹 Italian · Italiano" Tag="it-IT" />
                            <ComboBoxItem Content="🇰🇷 Korean · 한국어" Tag="ko-KR" />
                            <ComboBoxItem Content="🇧🇷 Portuguese (Brazil) · Português (Brasil)" Tag="pt-BR" />
                            <ComboBoxItem Content="🇵🇹 Portuguese (Portugal) · Português (Portugal)" Tag="pt-PT" />
                            <ComboBoxItem Content="🇪🇸 Spanish · Español" Tag="es-ES" />
                            <ComboBoxItem Content="🇻🇳 Vietnamese · Tiếng Việt" Tag="vi-VN" />
                        </ComboBox>
                    </StackPanel>
                    <Rectangle
                        Width="34"
                        Height="2"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        Fill="{ThemeResource BrandCoralBrush}" />
                    <TextBlock
                        Tag="Options.Theme.Header"
                        CharacterSpacing="120"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Theme" />
                    <Grid Margin="0,8,0,0" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="ThemeSystemButton"
                            MinHeight="36"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="System theme"
                            Click="ThemeButton_Click"
                            IsChecked="True"
                            Tag="Options.Theme.system">
                            <TextBlock Tag="Options.Theme.system" Text="System" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ThemeLightButton"
                            Grid.Column="1"
                            MinHeight="36"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Light theme"
                            Click="ThemeButton_Click"
                            Tag="Options.Theme.light">
                            <TextBlock Tag="Options.Theme.light" Text="Light" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ThemeDarkButton"
                            Grid.Column="2"
                            MinHeight="36"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Dark theme"
                            Click="ThemeButton_Click"
                            Tag="Options.Theme.dark">
                            <TextBlock Tag="Options.Theme.dark" Text="Dark" />
                        </ToggleButton>
                    </Grid>

                    <ComboBox
                        x:Name="PositionBox"
                        Margin="0,16,0,0"
                        Tag="Options.Position"
                        HorizontalAlignment="Stretch"
                        Header="Main window position">
                        <ComboBoxItem Content="Bottom center" Tag="bottom-center" />
                        <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
                        <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
                        <ComboBoxItem Content="Top left" Tag="top-left" />
                        <ComboBoxItem Content="Top right" Tag="top-right" />
                    </ComboBox>

                    <Border Height="1" Margin="0,18,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Margin="0,14,0,0" Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Tag="Options.Section.Window"
                            Text="Window" />
                        <ToggleSwitch
                            x:Name="AutoHideTitleBarSwitch"
                            Header="Automatically hide title bars"
                            IsOn="True"
                            OffContent=""
                            OnContent=""
                            Tag="Options.Window.AutoHideTitleBar" />
                        <TextBlock
                            Tag="Options.Window.AutoHideTitleBar.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Applies to all windows. Turn off to keep title bars visible."
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="WindowSnappingSwitch"
                            Header="Window snapping"
                            IsOn="True"
                            OffContent=""
                            OnContent=""
                            Tag="Options.Window.Snapping" />
                        <TextBlock
                            Tag="Options.Window.Snapping.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Snap within 5 pixels of other WorkTrail windows or monitor edges. Leaving the monitor disables snapping for the rest of that drag."
                            TextWrapping="Wrap" />
                        <Slider
                            x:Name="MainWindowOpacitySlider"
                            Header="Window opacity"
                            Maximum="100"
                            Minimum="25"
                            StepFrequency="1"
                            Tag="Options.Window.Opacity"
                            Value="100" />
                        <ToggleSwitch
                            x:Name="MainWindowShowInTaskbarSwitch"
                            Header="Show window icon in taskbar"
                            OffContent=""
                            OnContent=""
                            Tag="Options.Window.ShowInTaskbar" />
                    </StackPanel>

                    </StackPanel>

                    <Border
                        x:Name="OptionsNarrowDivider"
                        Grid.Row="1"
                        Grid.Column="0"
                        Height="1"
                        Margin="0,20,0,20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Border
                        x:Name="OptionsWideDivider"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,2"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="Collapsed" />

                    <StackPanel x:Name="OptionsSecondaryPanel" Grid.Row="2" Grid.Column="0" Spacing="0">
                    <HyperlinkButton
                        x:Name="OcrAiSettingsButton"
                        MinHeight="36"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Open OCR and AI settings"
                        Click="OcrAiSettingsButton_Click"
                        Padding="0,8"
                        Tag="Options.AiConfiguration.Title">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="17"
                                Glyph="&#xE945;" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Tag="Options.AiConfiguration.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="OCR / AI settings" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Tag="Options.AiConfiguration.Subtitle"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Text extraction, search, and AI provider"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </HyperlinkButton>
                    <StackPanel Margin="0,14,0,0" Spacing="2">
                        <TextBlock
                            Tag="Options.Operations.Section"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Local data and tools" />
                        <TextBlock
                            Tag="Options.Operations.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Capture context and manage the local rules and extensions that shape stored activity data."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Margin="0,6,0,0" Spacing="0">
                        <TextBlock
                            Tag="Options.Navigation.SnapshotAi.Title"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Screen captures and AI analysis"
                            Visibility="Collapsed" />
                        <TextBlock
                            Tag="Options.Navigation.SnapshotAi.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Capture the current context, review the latest image, or ask the configured AI provider to analyze what is happening."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="SnapshotAiOperationsLink"
                            MinHeight="36"
                            Padding="0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="SnapshotAiOperationsLink_Click">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FFE88F6B" Glyph="&#xE7ED;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Tag="Options.Navigation.SnapshotAi.Action"
                                    Text="Open screen-capture and AI tools"
                                    TextWrapping="Wrap" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Glyph="&#xE76C;" />
                            </Grid>
                        </HyperlinkButton>
                    </StackPanel>

                    <StackPanel Margin="0" Spacing="0">
                        <TextBlock
                            Tag="Options.Navigation.Privacy.Title"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Privacy"
                            Visibility="Collapsed" />
                        <TextBlock
                            Tag="Options.Navigation.Privacy.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Define on-device rules that prevent sensitive apps, window titles, or context details from being captured or shared with an AI provider."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="PrivacyOperationsLink"
                            MinHeight="36"
                            Padding="0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="PrivacyOperationsLink_Click">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FFA97BEA" Glyph="&#xE72E;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Tag="Options.Navigation.Privacy.Action"
                                    Text="Open privacy settings"
                                    TextWrapping="Wrap" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Glyph="&#xE76C;" />
                            </Grid>
                        </HyperlinkButton>
                    </StackPanel>

                    <StackPanel Margin="0" Spacing="0">
                        <TextBlock
                            Tag="Options.Navigation.Retention.Title"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Data retention"
                            Visibility="Collapsed" />
                        <TextBlock
                            Tag="Options.Navigation.Retention.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Review how long activity and screen captures remain on this PC, preview cleanup, and remove eligible data with confirmation."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="RetentionOperationsLink"
                            MinHeight="36"
                            Padding="0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="RetentionOperationsLink_Click">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF85A8DB" Glyph="&#xE823;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Tag="Options.Navigation.Retention.Action"
                                    Text="Open data-retention settings"
                                    TextWrapping="Wrap" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Glyph="&#xE76C;" />
                            </Grid>
                        </HyperlinkButton>
                    </StackPanel>

                    <StackPanel Margin="0" Spacing="0">
                        <TextBlock
                            Tag="Options.Navigation.Plugins.Title"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Context plugins"
                            Visibility="Collapsed" />
                        <TextBlock
                            Tag="Options.Navigation.Plugins.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Manage local app-specific context enrichers without changing core activity tracking."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="PluginsOperationsLink"
                            MinHeight="36"
                            Padding="0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="PluginsOperationsLink_Click">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF71CBB7" Glyph="&#xE90F;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Tag="Options.Navigation.Plugins.Action"
                                    Text="Open context plugins"
                                    TextWrapping="Wrap" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Glyph="&#xE76C;" />
                            </Grid>
                        </HyperlinkButton>
                    </StackPanel>

                    <Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Advanced app options"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="GeneralAdvancedButton_Click"
                        Padding="4,8"
                        Tag="Options.Advanced">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Tag="Options.Advanced" Text="Advanced options" />
                            <FontIcon
                                x:Name="GeneralAdvancedChevron"
                                Grid.Column="1"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <StackPanel x:Name="GeneralAdvancedPanel" Margin="0,8,0,0" Spacing="10" Visibility="Collapsed">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Options.Section.Startup" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Startup" />
                            <TextBlock
                                Tag="Options.Section.Startup.Description"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Choose how WorkTrail behaves after Windows sign-in."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid MinHeight="44" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Tag="Options.StartWithWindows.Header" Text="Start with Windows" TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="StartWithWindowsSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Start with Windows"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid MinHeight="44" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Tag="Options.StartTracking.Header" Text="Start tracking on launch" TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="StartTrackingOnLaunchSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Start tracking on launch"
                                OffContent=""
                                OnContent="" />
                        </Grid>

                    </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="OcrAiOptionsView" Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel x:Name="SearchOptionsView" Padding="0,0,18,12" Spacing="18">
                    <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Tag="Options.Search.Section" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Local search" />
                    </StackPanel>
                    <ComboBox x:Name="SearchLanguageBox" Tag="Options.Search.Language" HorizontalAlignment="Stretch" Header="Search language">
                        <ComboBoxItem Content="System" Tag="system" />
                        <ComboBoxItem Content="English (United States)" Tag="en-US" />
                        <ComboBoxItem Content="Italiano" Tag="it-IT" />
                        <ComboBoxItem Content="Français" Tag="fr-FR" />
                        <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                        <ComboBoxItem Content="Español" Tag="es-ES" />
                        <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" />
                        <ComboBoxItem Content="한국어" Tag="ko-KR" />
                        <ComboBoxItem Content="Português (Portugal)" Tag="pt-PT" />
                        <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                    </ComboBox>
                    <Grid MinHeight="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Tag="Options.Search.Synonyms" Text="Use synonyms" TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="SearchSynonymsSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Use synonyms"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                    <Grid MinHeight="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Tag="Options.Search.TypoTolerance" Text="Tolerate typing errors" TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="SearchTypoToleranceSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Tolerate typing errors"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                    <Button
                        x:Name="RebuildSearchIndexButton"
                        MinHeight="58"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Rebuild search index"
                        Click="RebuildSearchIndexButton_Click">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="17"
                                Glyph="&#xE895;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Tag="Options.Search.Rebuild" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rebuild search indexes" />
                                <TextBlock
                                    Tag="Options.Search.Rebuild.Description"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Open progress for results and suggestions"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="AiOptionsView" Spacing="0">
                    <Grid MinHeight="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Tag="Options.OpenAi.Header"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="AI features"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="OpenAiEnabledSwitch"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="AI features"
                            IsEnabled="{Binding CanToggle, Mode=OneWay}"
                            IsOn="{Binding Enabled, Mode=OneWay}"
                            OffContent=""
                            OnContent=""
                            Toggled="OpenAiEnabledSwitch_Toggled" />
                    </Grid>

                    <Border
                        x:Name="AiQuotaPanel"
                        Margin="0,10,0,2"
                        Padding="12"
                        AutomationProperties.LiveSetting="Polite"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="AiQuotaAccentBar"
                                Background="{ThemeResource TextFillColorSecondaryBrush}"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="AiQuotaTitleText"
                                        Tag="Options.AiQuota.Title"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Daily description quota"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <FontIcon
                                            x:Name="AiQuotaStateIcon"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE946;" />
                                        <TextBlock
                                            x:Name="AiQuotaStateText"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Quota unavailable" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="AiQuotaUsageText"
                                    AutomationProperties.LiveSetting="Polite"
                                    FontSize="26"
                                    FontWeight="SemiBold"
                                    Text="– / –" />
                                <ProgressBar
                                    x:Name="AiQuotaProgressBar"
                                    Height="6"
                                    AutomationProperties.Name="Daily AI description quota unavailable"
                                    IsHitTestVisible="False"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="0" />
                                <TextBlock
                                    x:Name="AiQuotaDescriptionText"
                                    Tag="Options.AiQuota.Description"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Only AI descriptions created successfully count toward this quota. It resets at local midnight: new descriptions resume then; screenshots already saved without one are not reprocessed automatically."
                                    TextWrapping="Wrap" />
                                <Expander
                                    x:Name="AiDailyLimitExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Set daily processing limit"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    SizeChanged="AiDailyLimitExpander_SizeChanged">
                                    <Expander.Header>
                                        <TextBlock
                                            x:Name="AiDailyLimitActionText"
                                            Tag="Options.AiQuota.Configure"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="Set daily processing limit" />
                                    </Expander.Header>
                                    <StackPanel Padding="0,2,0,6" Spacing="8">
                                        <NumberBox
                                            x:Name="AiDailyLimitBox"
                                            Tag="Options.AiQuota.Limit"
                                            AutomationProperties.Name="Screenshots processed per day"
                                            Header="Screenshots processed per day"
                                            Minimum="0"
                                            Maximum="400"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="20" />
                                        <TextBlock
                                            x:Name="AiDailyLimitHintText"
                                            Tag="Options.AiQuota.LimitHint"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Choose from 0 to 400. Set 0 to pause AI processing."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            x:Name="ApiKeyStatusIcon"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            x:Name="ApiKeyStatusText"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="API key status unavailable."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Expander
                        x:Name="ApiKeyExpander"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Set key"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        SizeChanged="ApiKeyExpander_SizeChanged">
                        <Expander.Header>
                            <TextBlock
                                x:Name="ApiKeyActionText"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Set key" />
                        </Expander.Header>
                        <StackPanel Padding="0,2,0,6" Spacing="0">
                            <PasswordBox
                                x:Name="ApiKeyBox"
                                Tag="Options.ApiKey"
                                Header="API key"
                                PasswordRevealMode="Peek"
                                PlaceholderText="Used from Windows; not copied by WorkTrail" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="Options.AiKeyStorageHint"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Stored only in your Windows user environment."
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,8,0,0"
                                Tag="ProviderSetup.Verify"
                                HorizontalAlignment="Stretch"
                                Click="SetApiKeyButton_Click"
                                Content="Test connection" />
                            <TextBlock Margin="0,8,0,0" Tag="ProviderSetup.Ai.Cost"
                                       Text="AI requests, including connection tests, may incur charges. Check prices and billing with your provider."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Expander>

                    <ComboBox
                        x:Name="ModelBox"
                        Margin="0,12,0,0"
                        Tag="Options.Model"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="Model"
                        SelectionChanged="ModelBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="294" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Background="{Binding AccentBrush}"
                                        CornerRadius="5" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding Key}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CapabilityLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border
                        x:Name="ModelInfoCard"
                        Margin="0,7,0,0"
                        Padding="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ModelAccentBar" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock
                                    x:Name="ModelDescriptionText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ModelKeyText" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Border
                                        x:Name="ModelPreviewBadge"
                                        Padding="6,1"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <TextBlock FontSize="11" Tag="Options.ModelPreview" Text="Preview" />
                                    </Border>
                                    <Border
                                        x:Name="ModelCapabilityBadge"
                                        Padding="6,1"
                                        Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <TextBlock x:Name="ModelCapabilityText" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button
                        x:Name="TestConnectionButton"
                        Margin="0,12,0,0"
                        MinWidth="132"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Test AI connection"
                        Click="TestConnectionButton_Click"
                        Content="Test connection"
                        Tag="Options.AiConnection.Test" />
                    <ComboBox
                        x:Name="AiReasoningEffortBox"
                        Margin="0,10,0,0"
                        Tag="Options.Reasoning"
                        HorizontalAlignment="Stretch"
                        Header="Thinking effort">
                        <ComboBoxItem Content="Automatic" Tag="auto" />
                        <ComboBoxItem Content="None" Tag="none" />
                        <ComboBoxItem Content="Low" Tag="low" />
                        <ComboBoxItem Content="Medium" Tag="medium" />
                        <ComboBoxItem Content="High" Tag="high" />
                        <ComboBoxItem Content="Very high" Tag="xhigh" />
                        <ComboBoxItem Content="Maximum" Tag="max" />
                    </ComboBox>

                    <Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Advanced AI options"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="AiAdvancedButton_Click"
                        Padding="4,8"
                        Tag="Options.Advanced">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Tag="Options.Advanced" Text="Advanced options" />
                            <FontIcon
                                x:Name="AiAdvancedChevron"
                                Grid.Column="1"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <StackPanel x:Name="AiAdvancedPanel" Margin="0,8,0,0" Spacing="10" Visibility="Collapsed">
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ComboBox x:Name="AiOutputDetailBox" Tag="Options.OutputDetail" HorizontalAlignment="Stretch" Header="Analysis detail">
                            <ComboBoxItem Content="Compact · lowest usage" Tag="compact" />
                            <ComboBoxItem Content="Balanced" Tag="balanced" />
                            <ComboBoxItem Content="Detailed · larger budget" Tag="detailed" />
                        </ComboBox>
                        <TextBox x:Name="AiCustomPromptBox" Tag="Options.CustomPrompt" AcceptsReturn="True" Header="Additional AI instruction (optional)" MinHeight="76" PlaceholderText="Example: Prioritize concise, factual descriptions." TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="IncludeDeviceLocationSwitch" Tag="Options.DeviceLocation" Header="Include Windows location in AI requests" OffContent="Off" OnContent="Windows Location" />
                        <ComboBox x:Name="AiProviderBox" Tag="Options.AiProvider" HorizontalAlignment="Stretch" Header="AI service" SelectionChanged="AiProviderBox_SelectionChanged">
                            <ComboBoxItem Content="OpenAI" Tag="openai" />
                            <ComboBoxItem Content="OpenRouter" Tag="openrouter" />
                            <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                        </ComboBox>
                        <TextBox x:Name="AiEndpointBox" Tag="Options.AiEndpoint" Header="Service address" />
                        <TextBox x:Name="AiApiKeyNameBox" Tag="Options.AiKeyVariable" Header="Windows key name" />

                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Margin="0,8,18,0"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
