<UserControl x:Class="WorkTrail.Controls.SensorTrackControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="SensorTraceOpacity">0.24</x:Double>
                    <SolidColorBrush x:Key="SensorCpuBrush" Color="#FFA34910"/>
                    <SolidColorBrush x:Key="SensorMemoryBrush" Color="#FF7F399A"/>
                    <SolidColorBrush x:Key="SensorGpuBrush" Color="#FF007376"/>
                    <SolidColorBrush x:Key="SensorStorageBrush" Color="#FF1966AD"/>
                    <SolidColorBrush x:Key="SensorBatteryBrush" Color="#FF29742F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:Double x:Key="SensorTraceOpacity">0.32</x:Double>
                    <SolidColorBrush x:Key="SensorCpuBrush" Color="#FFFFAB5E"/>
                    <SolidColorBrush x:Key="SensorMemoryBrush" Color="#FFD594E9"/>
                    <SolidColorBrush x:Key="SensorGpuBrush" Color="#FF58DCD8"/>
                    <SolidColorBrush x:Key="SensorStorageBrush" Color="#FF6FB9FF"/>
                    <SolidColorBrush x:Key="SensorBatteryBrush" Color="#FF8BE184"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="SensorTraceOpacity">0</x:Double>
                    <SolidColorBrush x:Key="SensorCpuBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorMemoryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorGpuBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorStorageBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorBatteryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Track" Padding="0,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <!-- The background shares the viewport bounds, independently of the foreground's text measurement. -->
        <Grid x:Name="TraceHost" IsHitTestVisible="False" Opacity="{ThemeResource SensorTraceOpacity}" AutomationProperties.AccessibilityView="Raw">
            <Canvas x:Name="TraceCanvas" SizeChanged="TraceCanvas_SizeChanged" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <Border x:Name="LevelBarTrack" Margin="44,0,0,0" Height="3" VerticalAlignment="Bottom" CornerRadius="1.5"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False" SizeChanged="LevelBarTrack_SizeChanged" AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="LevelBarFill" HorizontalAlignment="Left" CornerRadius="1.5"/>
        </Border>
        <Grid x:Name="ContentGrid" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MetricsColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="IdentityPanel" ColumnSpacing="16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon x:Name="DeviceIcon" FontFamily="Segoe Fluent Icons" FontSize="27" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="CategoryText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NameText" FontSize="12" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CapacityText" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="MetricsGrid" Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ValueColumn" Width="*"/><ColumnDefinition x:Name="TemperatureColumn" Width="*"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="Values" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ValueText" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SecondaryText" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel x:Name="TemperaturePanel" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="TemperatureLabel" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="TemperatureIcon" Glyph="&#xE9CA;" FontSize="18" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="TemperatureText" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TemperatureStatus" FontSize="11" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
