<UserControl x:Class="WorkTrail.Controls.WeatherKeySetupControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls">
    <StackPanel x:Name="RootPanel" Padding="16" Spacing="12">
        <TextBlock Tag="WeatherSetup.Title" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Tag="WeatherSetup.Explanation" TextWrapping="Wrap" />
        <PasswordBox x:Name="KeyBox" Tag="WeatherSetup.Key" Header="OpenWeather API key" PasswordRevealMode="Hidden" AutomationProperties.AutomationId="WeatherKey.Key" />
        <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
            <ProgressRing x:Name="VerificationProgress" Width="24" Height="24" IsActive="False" />
            <TextBlock Tag="WeatherSetup.Verifying" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Assertive" />
        <controls:ResponsiveWrapPanel>
            <Button x:Name="SaveButton" Tag="WeatherSetup.Save" Style="{StaticResource AccentButtonStyle}" Content="Verify and save" AutomationProperties.AutomationId="WeatherKey.Save" Click="Save_Click" />
            <Button x:Name="HelpButton" Tag="WeatherSetup.CreateKey" Content="Create a key" AutomationProperties.AutomationId="WeatherKey.Help" Click="Help_Click" />
            <Button x:Name="BackButton" Tag="WeatherSetup.Close" Content="Close" AutomationProperties.AutomationId="WeatherKey.Back" Click="Back_Click" />
        </controls:ResponsiveWrapPanel>
    </StackPanel>
</UserControl>
