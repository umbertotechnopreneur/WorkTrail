<UserControl x:Class="WorkTrail.Controls.SensorOptionsControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel x:Name="HardwareSensorsSection" Margin="0" Spacing="8">
                        <TextBlock Tag="Options.Sensors.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sensors" />
                        <ToggleSwitch x:Name="HardwareSensorsEnabledSwitch" Toggled="Enabled_Toggled" Tag="Options.Sensors.Enabled" Header="Read hardware sensors" OffContent="" OnContent="" />
                        <TextBlock Tag="Options.Sensors.Enabled.Description" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Updates while recording; otherwise readings refresh only when requested." TextWrapping="Wrap" />
                        <StackPanel x:Name="HardwareSensorOptionsPanel" Spacing="8">
                            <ToggleSwitch x:Name="HardwareAdvancedSwitch" Toggled="Advanced_Toggled" Tag="Options.Sensors.Advanced" Header="Use advanced sensors" OffContent="" OnContent="" />
                            <TextBlock Tag="Hardware.Advanced.Description" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="On Windows x64, advanced sensors require administrator privileges. The button installs the included PawnIO component if needed, then activates sensors for this session. Accept the Windows prompts; WorkTrail itself does not need to run as administrator." TextWrapping="Wrap" />
                            <Button x:Name="ActivateAdvancedSensorsButton" Tag="Hardware.Advanced.Action" HorizontalAlignment="Left" Click="ActivateAdvancedSensorsButton_Click" AutomationProperties.Name="Install and activate advanced sensors" ToolTipService.ToolTip="Install and activate advanced sensors">
                                <TextBlock Tag="Hardware.Advanced.Action" Text="Install and activate advanced sensors" TextWrapping="Wrap" />
                            </Button>
                            <TextBlock x:Name="HardwareActivationStatusText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Slider x:Name="HardwareSamplingSlider" ValueChanged="Sampling_Changed" Header="Update frequency" Tag="Options.Sensors.Sampling" Minimum="0" Maximum="3" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" SnapsTo="Ticks" IsThumbToolTipEnabled="False" Value="1" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Tag="Options.Sensors.Profile.slow" FontSize="11" Text="Slow" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Tag="Options.Sensors.Profile.normal" HorizontalAlignment="Center" FontSize="11" Text="Normal" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Tag="Options.Sensors.Profile.fast" HorizontalAlignment="Center" FontSize="11" Text="Fast" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Tag="Options.Sensors.Profile.fastest" HorizontalAlignment="Right" FontSize="11" Text="Fastest" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock x:Name="HardwareSamplingSummaryText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
</UserControl>
