<UserControl
    x:Class="WorkTrail.Controls.ScreenshotGalleryViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls">
    <Grid x:Name="GallerySurface" MinHeight="360" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel x:Name="VipSection" Visibility="Collapsed" Spacing="4">
            <TextBlock Tag="Snapshot.Vip.Featured" Text="VIP snapshots" FontWeight="SemiBold" Margin="20,8,20,0" />
            <controls:ScreenshotTimelineControl x:Name="VipTimeline" />
        </StackPanel>
        <controls:ScreenshotImageViewerControl
            x:Name="ImageViewer"
            Grid.Row="1"
            MinHeight="340" />

        <Grid x:Name="EmptyGalleryPanel" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed">
            <StackPanel
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE722;" />
                <TextBlock
                    x:Name="EmptyGalleryText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Tag="Screenshots.Empty"
                    Text="No screenshots for this day."
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <ProgressRing
            x:Name="GalleryProgressRing"
            Grid.RowSpan="2"
            Width="30"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
