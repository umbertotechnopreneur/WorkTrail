<UserControl x:Class="WorkTrail.Controls.VipBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="VipBadgeBrush" Color="#9A6500" /></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="VipBadgeBrush" Color="#FFD166" /></ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast"><StaticResource x:Key="VipBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Path Width="14" Height="12" Stretch="Uniform" Fill="{ThemeResource VipBadgeBrush}"
              Data="M 0,2 L 4,5 L 7,0 L 10,5 L 14,2 L 12,10 L 2,10 Z M 2,11 L 12,11 L 12,13 L 2,13 Z" />
        <TextBlock x:Name="Caption" Text="VIP" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource VipBadgeBrush}" />
    </StackPanel>
</UserControl>
