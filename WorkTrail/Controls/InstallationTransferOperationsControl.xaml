<UserControl
    x:Class="WorkTrail.Controls.InstallationTransferOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="560"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TransferExportBrush" Color="#246CB4" />
                    <SolidColorBrush x:Key="TransferImportBrush" Color="#16784B" />
                    <SolidColorBrush x:Key="TransferIdentityBrush" Color="#8551AA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TransferExportBrush" Color="#80BFFF" />
                    <SolidColorBrush x:Key="TransferImportBrush" Color="#75D8AA" />
                    <SolidColorBrush x:Key="TransferIdentityBrush" Color="#D1A6EB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TransferExportBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="TransferImportBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="TransferIdentityBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" MaxWidth="820">
        <StackPanel x:Name="SectionBody" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock
                    Tag="Operations.InstallationTransfer.Title"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Data transfer" />
                <TextBlock
                    Tag="Operations.InstallationTransfer.Description"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Move your history and screenshots between PCs. Choose an action below."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Pivot x:Name="TransferSections" SelectionChanged="TransferSections_SelectionChanged">
                <PivotItem x:Name="ExportSection">
                    <PivotItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                          VerticalAlignment="Center" Foreground="{ThemeResource TransferExportBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="ExportHeaderText" Text="Export" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                    </PivotItem.Header>
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Tag="Operations.InstallationTransfer.Export.Description"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Save your history and retained screenshots in a .tmuarchive file to transfer them to another PC."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="ExportArchiveButton"
                            Tag="Operations.InstallationTransfer.Export.Action"
                            HorizontalAlignment="Left"
                            Click="ExportArchiveButton_Click"
                            Content="Export archive…"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel x:Name="ExportResultPanel" Spacing="2" Visibility="Collapsed">
                            <TextBlock x:Name="ExportResultSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ExportResultPathText"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </PivotItem>
                <PivotItem x:Name="ImportSection">
                    <PivotItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                          VerticalAlignment="Center" Foreground="{ThemeResource TransferImportBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="ImportHeaderText" Text="Import" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                    </PivotItem.Header>
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <TextBlock
                            Tag="Operations.InstallationTransfer.Import.Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose a .tmuarchive file and check its contents before importing."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="PreviewImportButton"
                            Tag="Operations.InstallationTransfer.Import.PreviewAction"
                            HorizontalAlignment="Left"
                            Click="PreviewImportButton_Click"
                            Content="Choose archive…" />

                        <StackPanel x:Name="ImportPreviewPanel" Spacing="16" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ImportArchiveNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ImportArchivePathText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ImportPreviewSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Tag="Operations.InstallationTransfer.Import.ContentTitle"
                                    AutomationProperties.HeadingLevel="Level3"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Archive contents" />
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="ImportActivityCountText" FontSize="24" FontWeight="SemiLight" TextWrapping="Wrap" />
                                        <TextBlock Tag="Operations.InstallationTransfer.Import.ActivityCount" Text="Activity records" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock x:Name="ImportAiCountText" FontSize="24" FontWeight="SemiLight" TextWrapping="Wrap" />
                                        <TextBlock Tag="Operations.InstallationTransfer.Import.AiCount" Text="AI records" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock x:Name="ImportScreenshotCountText" FontSize="24" FontWeight="SemiLight" TextWrapping="Wrap" />
                                        <TextBlock Tag="Operations.InstallationTransfer.Import.ScreenshotCount" Text="Screenshots" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock x:Name="ImportScreenshotSizeText" FontSize="24" FontWeight="SemiLight" TextWrapping="Wrap" />
                                        <TextBlock Tag="Operations.InstallationTransfer.Import.ScreenshotSize" Text="Screenshot size" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Tag="Operations.InstallationTransfer.Import.Installations"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Data sources" />
                                <ItemsControl x:Name="ImportInstallationsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="36" Margin="0,2" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" Background="{Binding AccentBrush}" CornerRadius="12">
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="White" Glyph="{Binding Glyph}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding MachineLabel}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock
                                Tag="Operations.InstallationTransfer.Import.BeforeMerge"
                                Text="Merge this history with this PC. Identical records are skipped; app settings stay unchanged."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AlreadyImportedText"
                                Tag="Operations.InstallationTransfer.Import.AlreadyImported"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="This archive was already imported on this installation."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="MergeImportButton"
                                Tag="Operations.InstallationTransfer.Import.MergeAction"
                                HorizontalAlignment="Left"
                                Click="MergeImportButton_Click"
                                Content="Import into this PC"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ImportResultText"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </PivotItem>
                <PivotItem x:Name="InstallationsSection">
                    <PivotItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE977;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                          VerticalAlignment="Center" Foreground="{ThemeResource TransferIdentityBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="InstallationsHeaderText" Text="Installations" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                    </PivotItem.Header>
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Tag="Operations.InstallationTransfer.Installations.Description"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Choose an installation and give it a name, color, and icon to recognize its activity."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView
                            x:Name="InstallationsList"
                            MaxHeight="240"
                            AutomationProperties.Name="Known installations"
                            SelectionChanged="InstallationsList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="52" Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding AccentBrush}"
                                            CornerRadius="16">
                                            <FontIcon
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="15"
                                                Foreground="White"
                                                Glyph="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding MachineLabel}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            x:Name="NoInstallationsText"
                            Tag="Operations.InstallationTransfer.Installations.Empty"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No installation profiles are available."
                            TextWrapping="Wrap" />

                        <StackPanel x:Name="ProfileEditor" Spacing="10" Visibility="Collapsed">
                            <TextBlock
                                x:Name="MachineNameText"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBox
                                x:Name="FriendlyNameBox"
                                Tag="Operations.InstallationTransfer.FriendlyName"
                                Header="Friendly name"
                                MaxLength="64"
                                PlaceholderText="For example: Office laptop"
                                TextChanged="FriendlyNameBox_TextChanged" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="ColorBox"
                                    Tag="Operations.InstallationTransfer.Color"
                                    HorizontalAlignment="Stretch"
                                    Header="Color"
                                    SelectionChanged="AppearanceBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="12" Height="12" Background="{Binding AccentBrush}" CornerRadius="6" />
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox
                                    x:Name="IconBox"
                                    Grid.Column="1"
                                    Tag="Operations.InstallationTransfer.Icon"
                                    HorizontalAlignment="Stretch"
                                    Header="Icon"
                                    SelectionChanged="AppearanceBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="{Binding Glyph}" />
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Button
                                x:Name="SaveProfileButton"
                                Tag="Operations.InstallationTransfer.SaveProfile"
                                HorizontalAlignment="Left"
                                Click="SaveProfileButton_Click"
                                Content="Save installation identity"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </Grid>
</UserControl>
