<UserControl
    x:Class="WorkTrail.Controls.LocalSkyControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <x:Double x:Key="SkyArtworkOpacity">1</x:Double>
                    <SolidColorBrush x:Key="SkyLabelBackdropBrush" Color="#B0071224" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="SkyArtworkOpacity">1</x:Double>
                    <SolidColorBrush x:Key="SkyLabelBackdropBrush" Color="#B0071224" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="SkyArtworkOpacity">0</x:Double>
                    <StaticResource x:Key="SkyLabelBackdropBrush" ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Physical sky colors are independent of the enclosing acrylic theme; chart text stays light. -->
    <Grid RequestedTheme="Dark" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid x:Name="SkyDecorations" Opacity="{ThemeResource SkyArtworkOpacity}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="ZenithColorStop" Color="#080F24" Offset="0" />
                    <GradientStop x:Name="UpperSkyColorStop" Color="#142845" Offset="0.65" />
                    <GradientStop x:Name="HorizonColorStop" Color="#273C57" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid Height="120" VerticalAlignment="Bottom" Opacity="0.7">
                <Grid.Background>
                    <ImageBrush ImageSource="ms-appx:///Assets/Celestial/Artwork/sky-horizon-v1.png" Stretch="UniformToFill" AlignmentY="Bottom" />
                </Grid.Background>
            </Grid>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14000000" Offset="0" />
                        <GradientStop Color="#10000000" Offset="0.7" />
                        <GradientStop Color="#54000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <Border x:Name="PrimaryPalette" Background="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <Border x:Name="SecondaryPalette" Background="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        <Border x:Name="AccentPalette" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <Border x:Name="DividerPalette" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />
        <Border x:Name="LabelPalette" Background="{ThemeResource SkyLabelBackdropBrush}" Visibility="Collapsed" />
        <Grid x:Name="SkyViewport" SizeChanged="SkyViewport_SizeChanged">
            <Canvas x:Name="SkyCanvas" Background="Transparent" />
        </Grid>
    </Grid>
</UserControl>
