<UserControl
    x:Class="WorkTrail.Controls.OperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <Grid x:Name="RootLayout">
        <ScrollViewer x:Name="OperationsScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel x:Name="OperationsBody" Padding="0,0,18,12" Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Tag="Options.Operations.Section" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Local data and tools" />
                    <TextBlock Tag="Options.Operations.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Open focused pages for captures, privacy rules, retention, and app-specific details." TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Tag="Options.Navigation.SnapshotAi.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Screen captures and AI" />
                    <TextBlock Tag="Options.Navigation.SnapshotAi.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Capture or inspect images and request a description from the configured AI provider." TextWrapping="Wrap" />
                    <HyperlinkButton AutomationProperties.AutomationId="Operations.OpenSnapshotAiLink" x:Name="OpenSnapshotAiLink" MinHeight="36" Padding="0,6" HorizontalAlignment="Left" Click="OpenSnapshotAiLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FFE88F6B" Glyph="&#xE7ED;" />
                            <TextBlock Tag="Options.Navigation.SnapshotAi.Action" Text="Open screen capture tools" />
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="4">
                    <TextBlock Tag="Options.Navigation.Privacy.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Privacy rules" />
                    <TextBlock Tag="Options.Navigation.Privacy.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Choose which apps, window titles, and context details WorkTrail must ignore before storing or sharing context." TextWrapping="Wrap" />
                    <HyperlinkButton AutomationProperties.AutomationId="Operations.OpenPrivacyLink" x:Name="OpenPrivacyLink" MinHeight="36" Padding="0,6" HorizontalAlignment="Left" Click="OpenPrivacyLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FFA97BEA" Glyph="&#xE72E;" />
                            <TextBlock Tag="Options.Navigation.Privacy.Action" Text="Manage privacy rules" />
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="4">
                    <TextBlock Tag="Options.Navigation.Retention.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Data retention" />
                    <TextBlock Tag="Options.Navigation.Retention.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Preview what can be removed and run a confirmed cleanup of local activity data and screen captures." TextWrapping="Wrap" />
                    <HyperlinkButton AutomationProperties.AutomationId="Operations.OpenRetentionLink" x:Name="OpenRetentionLink" MinHeight="36" Padding="0,6" HorizontalAlignment="Left" Click="OpenRetentionLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF85A8DB" Glyph="&#xE823;" />
                            <TextBlock Tag="Options.Navigation.Retention.Action" Text="Review data retention" />
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="4">
                    <TextBlock Tag="Options.Navigation.Plugins.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="App details" />
                    <TextBlock Tag="Options.Navigation.Plugins.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Choose which local app-specific context enrichers can add details to the timeline." TextWrapping="Wrap" />
                    <HyperlinkButton AutomationProperties.AutomationId="Operations.OpenPluginsLink" x:Name="OpenPluginsLink" MinHeight="36" Padding="0,6" HorizontalAlignment="Left" Click="OpenPluginsLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF71CBB7" Glyph="&#xE90F;" />
                            <TextBlock Tag="Options.Navigation.Plugins.Action" Text="Manage app details" />
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="4">
                    <TextBlock Tag="Operations.InstallationTransfer.Navigation.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Installations and data transfer" />
                    <TextBlock Tag="Operations.InstallationTransfer.Navigation.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Name each installation and export or preview and merge local data and screenshots from another system." TextWrapping="Wrap" />
                    <HyperlinkButton AutomationProperties.AutomationId="Operations.OpenInstallationTransferLink"
                        x:Name="OpenInstallationTransferLink"
                        Tag="Operations.InstallationTransfer.Navigation.Action"
                        MinHeight="36"
                        Padding="0,6"
                        HorizontalAlignment="Left"
                        AutomationProperties.HelpText="Name installations and transfer local data and screenshots between systems."
                        Click="OpenInstallationTransferLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF5CC2C7" Glyph="&#xE8B5;" />
                            <TextBlock Tag="Operations.InstallationTransfer.Navigation.Action" Text="Manage installations and archives" />
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE76C;" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="8">
                    <TextBlock Tag="Operations.AtomicNuke.Title" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Atomic nuke" />
                    <TextBlock Tag="Operations.AtomicNuke.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Permanently erase the WorkTrail-owned local data for this installation—records, screenshots, configuration, logs, search indexes, and metadata—then restart the app with default settings." TextWrapping="Wrap" />
                    <Button AutomationProperties.AutomationId="Operations.AtomicNukeButton"
                        x:Name="AtomicNukeButton"
                        MinHeight="40"
                        Margin="0,4,0,0"
                        Padding="14,8"
                        HorizontalAlignment="Left"
                        Background="#FFC83B31"
                        BorderBrush="#FFFF8A80"
                        Click="AtomicNukeButton_Click"
                        Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE74D;" />
                            <TextBlock Tag="Operations.AtomicNuke.Action" Text="Nuclearize everything" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DetailScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Visibility="Collapsed">
            <Grid Padding="0,0,18,12">
                <ContentPresenter x:Name="SnapshotAiHost" />
                <ContentPresenter x:Name="PrivacyHost" />
                <ContentPresenter x:Name="RetentionHost" />
                <ContentPresenter x:Name="PluginsHost" />
                <ContentPresenter x:Name="InstallationTransferHost" />
            </Grid>
        </ScrollViewer>

        <ProgressRing
            x:Name="OperationProgress"
            Canvas.ZIndex="101"
            Width="24"
            Height="24"
            Margin="0,12,48,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Operation in progress"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
