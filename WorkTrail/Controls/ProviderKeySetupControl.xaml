<UserControl
    x:Class="WorkTrail.Controls.ProviderKeySetupControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="HyperlinkButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Padding="28,20" RowSpacing="16" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="HeadingText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid x:Name="ColumnsGrid" ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EntryColumn" Width="3*" />
                        <ColumnDefinition x:Name="HelpColumn" Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" />
                        <PasswordBox AutomationProperties.AutomationId="ProviderKey.KeyBox" x:Name="KeyBox" PasswordRevealMode="Hidden" PasswordChanged="KeyBox_PasswordChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton AutomationProperties.AutomationId="ProviderKey.ShowKeyButton" x:Name="ShowKeyButton" Tag="ProviderSetup.ShowKey" Content="Show key"
                                          Click="ShowKeyButton_Click" />
                            <Button AutomationProperties.AutomationId="ProviderKey.PasteKeyButton" x:Name="PasteKeyButton" Tag="ProviderSetup.Paste" Content="Paste"
                                    Click="PasteKeyButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ExampleText" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Tag="ProviderSetup.PasteHint" Text="Paste your complete key, not the masked example." TextWrapping="Wrap" />
                        <TextBlock x:Name="ExistingKeyText" Tag="ProviderSetup.ExistingKey" Visibility="Collapsed" TextWrapping="Wrap" />
                        <Button AutomationProperties.AutomationId="ProviderKey.VerifyButton" x:Name="VerifyButton" Tag="ProviderSetup.Verify" Content="Test connection" Click="VerifyButton_Click"
                                HorizontalAlignment="Left" />
                        <ProgressRing x:Name="Progress" Width="24" Height="24" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                        <InfoBar x:Name="CostBar" IsOpen="True" Visibility="Collapsed" IsClosable="False" Severity="Warning" />
                        <InfoBar x:Name="ResultBar" IsOpen="True" Visibility="Collapsed" IsClosable="False" Severity="Success"
                                 AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="HelpPanel" Grid.Column="1" Spacing="12">
                        <TextBlock Tag="ProviderSetup.HelpTitle" Text="Need an API key?" FontSize="20" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                        <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" />
                        <HyperlinkButton AutomationProperties.AutomationId="ProviderKey.PortalButton" x:Name="PortalButton" Tag="ProviderSetup.Portal" Content="Open provider portal"
                                         Padding="0,4" Click="PortalButton_Click" />
                        <HyperlinkButton AutomationProperties.AutomationId="ProviderKey.GuideButton" x:Name="GuideButton" Tag="ProviderSetup.Guide" Content="What is a key? How to create one"
                                         Padding="0,4" Click="GuideButton_Click" />
                        <TextBlock x:Name="ActivationText" Tag="ProviderSetup.Weather.Activation" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <HyperlinkButton AutomationProperties.AutomationId="ProviderKey.PricingButton" x:Name="PricingButton" Tag="ProviderSetup.Pricing" Content="View provider prices and limits"
                                 Padding="0,0" Click="PricingButton_Click" />
                <TextBlock x:Name="PrivacyText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <HyperlinkButton AutomationProperties.AutomationId="ProviderKey.WithoutAiButton" x:Name="WithoutAiButton" Tag="ProviderSetup.WithoutAi" Content="Choose a profile without AI"
                             HorizontalAlignment="Left" Click="WithoutAiButton_Click" />
            <Button AutomationProperties.AutomationId="ProviderKey.CloseButton" x:Name="CloseButton" Grid.Column="1" Tag="About.Close" MinWidth="110" Content="Close" Click="CloseButton_Click" />
            <Button AutomationProperties.AutomationId="ProviderKey.ContinueButton" x:Name="ContinueButton" Grid.Column="2" Tag="ProviderSetup.Continue" MinWidth="110" Content="Continue" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" Click="ContinueButton_Click" />
        </Grid>
    </Grid>
</UserControl>
