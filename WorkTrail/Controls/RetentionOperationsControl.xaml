<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WorkTrail.Controls.RetentionOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="WrappingActionLabelTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ProgressRing x:Name="Progress" Canvas.ZIndex="1" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" IsActive="False" Visibility="Collapsed" />
        <StackPanel x:Name="SectionBody" Spacing="20">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Tag="Operations.Retention" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Data retention" />
                    <controls:PremiumBadge x:Name="TierBadge" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock Tag="Operations.Retention.Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Tag="Operations.Retention.PolicyMonths" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ToggleButton AutomationProperties.AutomationId="Retention.OneMonthButton" x:Name="OneMonthButton" HorizontalAlignment="Stretch" Click="RetentionMonth_Click" IsEnabled="False"><TextBlock Tag="Operations.Retention.OneMonth" Text="1 month" /></ToggleButton>
                    <ToggleButton AutomationProperties.AutomationId="Retention.TwoMonthsButton" x:Name="TwoMonthsButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="RetentionMonth_Click" IsEnabled="False"><StackPanel Spacing="4"><TextBlock Tag="Operations.Retention.TwoMonths" Text="2 months" TextAlignment="Center" TextWrapping="Wrap" /><controls:PremiumBadge x:Name="TwoMonthsBadge" HorizontalAlignment="Center" /></StackPanel></ToggleButton>
                    <ToggleButton AutomationProperties.AutomationId="Retention.ThreeMonthsButton" x:Name="ThreeMonthsButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="RetentionMonth_Click" IsEnabled="False"><StackPanel Spacing="4"><TextBlock Tag="Operations.Retention.ThreeMonths" Text="3 months" TextAlignment="Center" TextWrapping="Wrap" /><controls:PremiumBadge x:Name="ThreeMonthsBadge" HorizontalAlignment="Center" /></StackPanel></ToggleButton>
                </Grid>
                <TextBlock Tag="Operations.Retention.Limits" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="RetentionStatusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
            </StackPanel>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Spacing="12">
                <TextBlock Tag="Operations.Retention.Monthly" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Tag="Operations.Retention.Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Rectangle Grid.ColumnSpan="3" Height="1" Margin="40,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Ellipse Width="12" Height="12" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Column="1" Width="12" Height="12" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Grid.Column="2" Width="16" Height="16" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Grid.Row="1" Tag="Operations.Retention.FirstActivation" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Tag="Operations.Retention.LastCleanup" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Tag="Operations.Retention.NextCleanup" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FirstActivationText" Grid.Row="2" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LastCleanupText" Grid.Row="2" Grid.Column="1" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="NextCleanupText" Grid.Row="2" Grid.Column="2" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <TextBlock x:Name="MonthlyScheduleText" TextWrapping="Wrap" />
            </StackPanel>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Spacing="8">
                <TextBlock Tag="Operations.Retention.Preview" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Tag="Operations.Retention.Preview.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Border Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Tag="Operations.Retention.Records" Text="Activity" TextWrapping="Wrap" /><TextBlock x:Name="RecordsPreviewText" Grid.Column="1" Text="—" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Tag="Operations.Retention.Screenshots" Text="Screenshots" TextWrapping="Wrap" /><TextBlock x:Name="ScreenshotsPreviewText" Grid.Row="1" Grid.Column="1" Text="—" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Tag="Operations.Retention.Total" FontWeight="SemiBold" Text="Potential total" TextWrapping="Wrap" /><TextBlock x:Name="TotalPreviewText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="—" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <TextBlock x:Name="RetentionPreviewText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="Retention.RetentionPreviewButton" x:Name="RetentionPreviewButton" Tag="Operations.Retention.PreviewAction" Content="Show preview" Click="RetentionPreviewButton_Click" HorizontalAlignment="Left" ContentTemplate="{StaticResource WrappingActionLabelTemplate}" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                    <Button AutomationProperties.AutomationId="Retention.RetentionCleanupButton" x:Name="RetentionCleanupButton" Grid.Column="1" Tag="Operations.Retention.CleanupAction" Content="Review and delete…" Click="RunRetentionButton_Click" HorizontalAlignment="Left" ContentTemplate="{StaticResource WrappingActionLabelTemplate}" IsEnabled="False" />
                </Grid>
                <Expander AutomationProperties.AutomationId="Retention.PreviewPathsExpander" x:Name="PreviewPathsExpander" HorizontalAlignment="Stretch">
                    <ListView AutomationProperties.AutomationId="Retention.RetentionPathsList" x:Name="RetentionPathsList" MaxHeight="120" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" FontFamily="Cascadia Mono" IsTextSelectionEnabled="True" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" /></DataTemplate></ListView.ItemTemplate></ListView>
                </Expander>
            </StackPanel>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Spacing="8">
                <TextBox AutomationProperties.AutomationId="Retention.ScreenshotFolderBox" x:Name="ScreenshotFolderBox" Tag="Options.SnapshotFolder" Header="Screen-capture folder"
                         PlaceholderText="Folder for screen captures" LostFocus="ScreenshotFolderBox_LostFocus" IsEnabled="False" />
                <HyperlinkButton AutomationProperties.AutomationId="Retention.OpenFolderButton" x:Name="OpenFolderButton" Padding="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                 Click="OpenFolderButton_Click" IsEnabled="False">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Tag="Options.OpenFolderAction" Text="Open snapshot and debug-image folder" TextWrapping="Wrap" />
                    </Grid>
                </HyperlinkButton>
                <Grid MinHeight="52" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Tag="Options.KeepSnapshots.Header" Text="Keep screen captures" TextWrapping="Wrap" />
                        <TextBlock Tag="Options.KeepSnapshots.On" Text="Keep on this PC" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.AutomationId="Retention.KeepScreenshotsSwitch" x:Name="KeepScreenshotsSwitch" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  MinWidth="0" OffContent="" OnContent="" Toggled="KeepScreenshotsSwitch_Toggled" IsEnabled="False" />
                </Grid>
                <Expander AutomationProperties.AutomationId="Retention.CaptureSettingsExpander" x:Name="CaptureSettingsExpander" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Tag="Options.Section.Snapshots.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid MinHeight="44" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Tag="Options.SnapshotsEnabled.Header" Text="Allow screen captures" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch AutomationProperties.AutomationId="Retention.ScreenshotsEnabledSwitch" x:Name="ScreenshotsEnabledSwitch" Grid.Column="1" HorizontalAlignment="Right" MinWidth="0"
                                          OffContent="" OnContent="" Toggled="ScreenshotsEnabledSwitch_Toggled" IsEnabled="False" />
                        </Grid>
                        <ComboBox AutomationProperties.AutomationId="Retention.ScreenshotModeBox" x:Name="ScreenshotModeBox" Tag="Options.SnapshotMode" Header="What to capture" HorizontalAlignment="Stretch"
                                  SelectionChanged="ScreenshotModeBox_SelectionChanged" IsEnabled="False">
                            <ComboBoxItem Content="All displays" Tag="all-screens" />
                            <ComboBoxItem Content="Active window" Tag="active-window" />
                        </ComboBox>
                        <TextBox AutomationProperties.AutomationId="Retention.ScreenshotModeHintBox" x:Name="ScreenshotModeHintBox" Tag="Options.SnapshotResult" Header="Result" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" />
                        <ToggleSwitch AutomationProperties.AutomationId="Retention.HardwareSaveSnapshotsSwitch" x:Name="HardwareSaveSnapshotsSwitch" Tag="Options.Sensors.SaveSnapshots" Header="Save sensor readings with captures"
                                      OffContent="" OnContent="" Toggled="HardwareSaveSnapshotsSwitch_Toggled" IsEnabled="False" />
                        <TextBlock Tag="Options.Sensors.SaveSnapshots.Description" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <Expander AutomationProperties.AutomationId="Retention.OcrSettingsExpander" x:Name="OcrSettingsExpander" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <Grid MinHeight="44" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Tag="Options.Ocr.Enabled" Text="Extract screenshot text" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch AutomationProperties.AutomationId="Retention.OcrEnabledSwitch" x:Name="OcrEnabledSwitch" Grid.Column="1" HorizontalAlignment="Right" MinWidth="0"
                                          OffContent="" OnContent="" Toggled="OcrEnabledSwitch_Toggled" IsEnabled="False" />
                        </Grid>
                        <ComboBox AutomationProperties.AutomationId="Retention.OcrLanguageBox" x:Name="OcrLanguageBox" Tag="Options.Ocr.Language" Header="OCR language" HorizontalAlignment="Stretch"
                                  SelectionChanged="OcrLanguageBox_SelectionChanged" IsEnabled="False" />
                        <TextBlock Tag="Options.Ocr.Restart" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
