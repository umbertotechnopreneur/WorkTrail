<UserControl x:Class="WorkTrail.Controls.RetentionOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="WrappingActionLabelTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ProgressRing x:Name="Progress" Canvas.ZIndex="1" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" IsActive="False" Visibility="Collapsed" />
        <StackPanel x:Name="SectionBody" Spacing="20">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Tag="Operations.Retention" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Data retention" />
                    <controls:PremiumBadge x:Name="TierBadge" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock Tag="Operations.Retention.Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8">
                <ComboBox x:Name="RetentionMonthsBox" AutomationProperties.AutomationId="Retention.MonthsBox"
                          Header="Keep history for" HorizontalAlignment="Stretch" IsEnabled="False"
                          SelectionChanged="RetentionMonthsBox_SelectionChanged" />
                <TextBlock Tag="Operations.Retention.Limits" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="RetentionStatusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                <TextBlock Tag="History.DailyCleanup" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8">
                <Grid x:Name="StorageSummaryRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StorageUsageText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="StorageWarningLabel" Grid.Column="1" Tag="History.WarningThreshold" VerticalAlignment="Center" />
                    <NumberBox x:Name="StorageWarningBox" Grid.Column="2" AutomationProperties.AutomationId="Retention.StorageWarningBox"
                               Width="100" MinWidth="0" Minimum="0.1" Maximum="1024" SmallChange="1" LargeChange="10"
                               SpinButtonPlacementMode="Compact" ValueChanged="StorageWarningBox_ValueChanged" IsEnabled="False" />
                </Grid>
                <InfoBar x:Name="StorageWarning" Severity="Warning" IsOpen="False" IsClosable="False" />
            </StackPanel>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Spacing="8">
                <TextBlock Tag="History.DeleteTitle" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Tag="History.DeleteDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Grid x:Name="DeleteDateRangeRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeleteFromLabel" Tag="History.From" VerticalAlignment="Center" />
                    <CalendarDatePicker x:Name="DeleteFromPicker" Grid.Column="1" AutomationProperties.AutomationId="Retention.DeleteFromPicker"
                                        MinWidth="0" HorizontalAlignment="Stretch" DateChanged="DeleteRange_DateChanged" />
                    <TextBlock x:Name="DeleteToLabel" Grid.Column="2" Tag="History.To" VerticalAlignment="Center" />
                    <CalendarDatePicker x:Name="DeleteToPicker" Grid.Column="3" AutomationProperties.AutomationId="Retention.DeleteToPicker"
                                        MinWidth="0" HorizontalAlignment="Stretch" DateChanged="DeleteRange_DateChanged" />
                </Grid>
                <Button x:Name="RetentionCleanupButton" AutomationProperties.AutomationId="Retention.RetentionCleanupButton"
                        Tag="History.ReviewDelete" Content="Review and delete..." Click="RunRetentionButton_Click"
                        ContentTemplate="{StaticResource WrappingActionLabelTemplate}" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                <TextBlock x:Name="RetentionPreviewText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
            </StackPanel>
            <Expander x:Name="CaptureStorageExpander" AutomationProperties.AutomationId="Retention.CaptureStorageExpander" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                <TextBox AutomationProperties.AutomationId="Retention.ScreenshotFolderBox" x:Name="ScreenshotFolderBox" Tag="Options.SnapshotFolder" Header="Screen-capture folder"
                         PlaceholderText="Folder for screen captures" LostFocus="ScreenshotFolderBox_LostFocus" IsEnabled="False" />
                <HyperlinkButton AutomationProperties.AutomationId="Retention.OpenFolderButton" x:Name="OpenFolderButton" Padding="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                 Click="OpenFolderButton_Click" IsEnabled="False">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Tag="Options.OpenFolderAction" Text="Open snapshot and debug-image folder" TextWrapping="Wrap" />
                    </Grid>
                </HyperlinkButton>
                <Grid MinHeight="52" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Tag="Options.KeepSnapshots.Header" Text="Keep screen captures" TextWrapping="Wrap" />
                        <TextBlock Tag="Options.KeepSnapshots.On" Text="Keep on this PC" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.AutomationId="Retention.KeepScreenshotsSwitch" x:Name="KeepScreenshotsSwitch" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  MinWidth="0" OffContent="" OnContent="" Toggled="KeepScreenshotsSwitch_Toggled" IsEnabled="False" />
                </Grid>
                <Expander AutomationProperties.AutomationId="Retention.CaptureSettingsExpander" x:Name="CaptureSettingsExpander" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Tag="Options.Section.Snapshots.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid MinHeight="44" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Tag="Options.SnapshotsEnabled.Header" Text="Allow screen captures" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch AutomationProperties.AutomationId="Retention.ScreenshotsEnabledSwitch" x:Name="ScreenshotsEnabledSwitch" Grid.Column="1" HorizontalAlignment="Right" MinWidth="0"
                                          OffContent="" OnContent="" Toggled="ScreenshotsEnabledSwitch_Toggled" IsEnabled="False" />
                        </Grid>
                        <ComboBox AutomationProperties.AutomationId="Retention.ScreenshotModeBox" x:Name="ScreenshotModeBox" Tag="Options.SnapshotMode" Header="What to capture" HorizontalAlignment="Stretch"
                                  SelectionChanged="ScreenshotModeBox_SelectionChanged" IsEnabled="False">
                            <ComboBoxItem Content="All displays" Tag="all-screens" />
                            <ComboBoxItem Content="Active window" Tag="active-window" />
                        </ComboBox>
                        <TextBox AutomationProperties.AutomationId="Retention.ScreenshotModeHintBox" x:Name="ScreenshotModeHintBox" Tag="Options.SnapshotResult" Header="Result" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
