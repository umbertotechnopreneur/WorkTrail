<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceChipBackgroundBrush" Color="#46FFFFFF" />
            <SolidColorBrush x:Key="SurfaceChipBorderBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="SurfacePanelBackgroundBrush" Color="#32FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceChipBackgroundBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="SurfaceChipBorderBrush" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="SurfacePanelBackgroundBrush" Color="#1AFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SurfaceChipBackgroundBrush" Color="#46FFFFFF" />
            <SolidColorBrush x:Key="SurfaceChipBorderBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="SurfacePanelBackgroundBrush" Color="#32FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="SurfaceChipStyle" TargetType="Border">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{ThemeResource SurfaceChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="23" />
    </Style>

    <Style x:Key="SurfaceChipIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <Style x:Key="SurfaceChipTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
