<UserControl
    x:Class="WorkTrail.Controls.CelestialArtworkControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">
    <Viewbox Stretch="Uniform">
        <Border x:Name="ThumbnailFrame" Width="96" Height="96" CornerRadius="18">
            <!-- A fixed-size viewport crops one cell in layout coordinates, independently of brush transforms. -->
            <Canvas Width="96" Height="96">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0,0,96,96" />
                </Canvas.Clip>
                <Image x:Name="AtlasImage" Width="384" Height="288" Stretch="Fill"
                       Source="ms-appx:///Assets/Celestial/Artwork/celestial-atlas-v1.png" />
            </Canvas>
        </Border>
    </Viewbox>
</UserControl>
