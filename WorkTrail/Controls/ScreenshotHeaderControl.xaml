<UserControl
    x:Class="WorkTrail.Controls.ScreenshotHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush
                        x:Key="ScreenshotMetadataPillBrush"
                        FallbackColor="#DDF7F9FC"
                        TintColor="#FFF9FBFD"
                        TintLuminosityOpacity="0.12"
                        TintOpacity="0.05" />
                    <SolidColorBrush x:Key="ScreenshotMetadataPillBorderBrush" Color="#7AFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush
                        x:Key="ScreenshotMetadataPillBrush"
                        FallbackColor="#C61B2027"
                        TintColor="#FF11171D"
                        TintLuminosityOpacity="0.18"
                        TintOpacity="0.11" />
                    <SolidColorBrush x:Key="ScreenshotMetadataPillBorderBrush" Color="#38FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ScreenshotMetadataPillBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ScreenshotMetadataPillBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScreenshotMetadataPillBorderStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Background" Value="{ThemeResource ScreenshotMetadataPillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScreenshotMetadataPillBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="96" RowSpacing="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderWidthStates">
                <VisualState x:Name="CompactHeader">
                    <VisualState.Setters>
                        <Setter Target="DateSummaryPanel.Width" Value="260" />
                        <Setter Target="ExtendedDateText.FontSize" Value="22" />
                        <Setter Target="ExtendedDateText.LineHeight" Value="28" />
                        <Setter Target="InstallationFriendlyNameText.MaxWidth" Value="72" />
                        <Setter Target="InstallationMachineNameText.MaxWidth" Value="72" />
                        <Setter Target="PrivacyStatusBadge.MaxWidth" Value="24" />
                        <Setter Target="PrivacyStatusText.Visibility" Value="Collapsed" />
                        <Setter Target="SelectedDatePicker.Width" Value="160" />
                        <Setter Target="MetadataApplicationPill.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideHeader">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DateSummaryPanel.Width" Value="390" />
                        <Setter Target="ExtendedDateText.FontSize" Value="24" />
                        <Setter Target="ExtendedDateText.LineHeight" Value="30" />
                        <Setter Target="InstallationFriendlyNameText.MaxWidth" Value="130" />
                        <Setter Target="InstallationMachineNameText.MaxWidth" Value="120" />
                        <Setter Target="PrivacyStatusBadge.MaxWidth" Value="170" />
                        <Setter Target="PrivacyStatusText.Visibility" Value="Visible" />
                        <Setter Target="SelectedDatePicker.Width" Value="200" />
                        <Setter Target="MetadataApplicationPill.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            x:Name="DateSummaryPanel"
            Width="390"
            VerticalAlignment="Center"
            Spacing="4">
            <TextBlock
                x:Name="ExtendedDateText"
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                FontSize="24"
                FontWeight="SemiLight"
                LineHeight="30"
                MaxLines="1"
                Text="Sunday, 9 August 2026"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B9;" />
                    <TextBlock
                        x:Name="GalleryCountText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0 captures" />
                </StackPanel>
                <Grid
                    x:Name="InstallationProvenanceBadge"
                    MaxWidth="300"
                    HorizontalAlignment="Left"
                    AutomationProperties.LiveSetting="Polite"
                    ColumnSpacing="6"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="InstallationIconBadge"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="2"
                        CornerRadius="9">
                        <FontIcon
                            x:Name="InstallationIcon"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="9" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            x:Name="InstallationFriendlyNameText"
                            MaxWidth="130"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="·" />
                        <TextBlock
                            x:Name="InstallationMachineNameText"
                            MaxWidth="120"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>

        <CommandBar
            x:Name="ScreenshotToolbar"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            MinWidth="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            ClosedDisplayMode="Compact"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            OverflowButtonVisibility="Auto">
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.ZoomOutButton"
                x:Name="ZoomOutButton"
                Click="ZoomOutButton_Click"
                IsEnabled="False"
                Label="Zoom out"
                Tag="Screenshots.Toolbar.ZoomOut"
                AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE71F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.ZoomResetButton"
                x:Name="ZoomResetButton"
                Click="ZoomResetButton_Click"
                IsEnabled="False"
                Label="Reset zoom to 100%"
                Tag="Screenshots.Toolbar.ZoomReset"
                AutomationProperties.Name="Reset zoom to 100%" ToolTipService.ToolTip="Reset zoom to 100%">
                <AppBarButton.Icon>
                    <FontIcon
                        x:Name="ZoomPercentIcon"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Glyph="100%" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.ZoomInButton"
                x:Name="ZoomInButton"
                Click="ZoomInButton_Click"
                IsEnabled="False"
                Label="Zoom in"
                Tag="Screenshots.Toolbar.ZoomIn"
                AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE8A3;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton AutomationProperties.AutomationId="Gallery.Header.DetailsToggleButton"
                x:Name="DetailsToggleButton"
                Click="DetailsToggleButton_Click"
                IsEnabled="False"
                Label="Show snapshot details"
                Tag="Screenshots.Details.Show"
                AutomationProperties.Name="Show snapshot details" ToolTipService.ToolTip="Show snapshot details">
                <AppBarToggleButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE8A0;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator />
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.SaveButton"
                x:Name="SaveButton"
                Click="SaveButton_Click"
                IsEnabled="False"
                Label="Save selected image"
                Tag="Screenshots.Toolbar.Save"
                AutomationProperties.Name="Save selected image" ToolTipService.ToolTip="Save selected image">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.ShareButton"
                x:Name="ShareButton"
                Click="ShareButton_Click"
                IsEnabled="False"
                Label="Share with another app"
                Tag="Screenshots.Toolbar.Share"
                AutomationProperties.Name="Share with another app" ToolTipService.ToolTip="Share with another app">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE72D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.OpenFolderButton"
                x:Name="OpenFolderButton"
                Click="OpenFolderButton_Click"
                Label="Open containing folder"
                Tag="Screenshots.Toolbar.OpenFolder"
                AutomationProperties.Name="Open containing folder" ToolTipService.ToolTip="Open containing folder">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.DeleteScreenshotButton"
                x:Name="DeleteScreenshotButton"
                Click="DeleteScreenshotButton_Click"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                IsEnabled="False"
                Label="Delete screenshot"
                Tag="Screenshots.Toolbar.DeleteScreenshot"
                AutomationProperties.Name="Delete screenshot" ToolTipService.ToolTip="Delete screenshot">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="Gallery.Header.DeleteAnalysisButton"
                x:Name="DeleteAnalysisButton"
                Click="DeleteAnalysisButton_Click"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                IsEnabled="False"
                Label="Delete analysis data"
                Tag="Screenshots.Toolbar.DeleteAnalysis"
                AutomationProperties.Name="Delete analysis data" ToolTipService.ToolTip="Delete analysis data">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <StackPanel
            x:Name="MetadataPanel"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <Border Style="{StaticResource ScreenshotMetadataPillBorderStyle}">
                <StackPanel
                    x:Name="MetadataDateItem"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE787;" />
                    <TextBlock
                        x:Name="MetadataDateValueText"
                        MaxWidth="94"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="--"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScreenshotMetadataPillBorderStyle}">
                <StackPanel
                    x:Name="MetadataTimeItem"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE823;" />
                    <TextBlock
                        x:Name="MetadataTimeValueText"
                        MaxWidth="54"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="--"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border
                x:Name="MetadataApplicationPill"
                Style="{StaticResource ScreenshotMetadataPillBorderStyle}">
                <StackPanel
                    x:Name="MetadataApplicationItem"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7F4;" />
                    <TextBlock
                        x:Name="MetadataAppValueText"
                        MaxWidth="112"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="--"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <StackPanel
                x:Name="PrivacyStatusBadge"
                MaxWidth="170"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <FontIcon
                    x:Name="PrivacyStatusIcon"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE83D;" />
                <TextBlock
                    x:Name="PrivacyStatusText"
                    MaxWidth="146"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Privacy status unavailable"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <CalendarDatePicker AutomationProperties.AutomationId="Gallery.Header.SelectedDatePicker"
                x:Name="SelectedDatePicker"
                Width="200"
                Height="40"
                HorizontalAlignment="Left"
                DateFormat="{}{day.integer} {month.full} {year.full}"
                PlaceholderText="Select a day"
                ToolTipService.ToolTip="Select date" />
        </StackPanel>
    </Grid>
</UserControl>
