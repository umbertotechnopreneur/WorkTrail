<UserControl
    x:Class="WorkTrail.Controls.WeeklyHoursEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ScheduleSelectionBrush" Color="#FFCAE4ED" />
                    <SolidColorBrush x:Key="ScheduleSelectionTextBrush" Color="#FF174E62" />
                    <SolidColorBrush x:Key="ScheduleSelectionEdgeBrush" Color="#FF206A84" />
                    <SolidColorBrush x:Key="ScheduleHourLineBrush" Color="#40000000" />
                    <SolidColorBrush x:Key="ScheduleCellBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="ScheduleCellHoverBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="ScheduleCellPressedBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="ScheduleWeekendBackgroundBrush" Color="#0EDB4B32" />
                    <SolidColorBrush x:Key="ScheduleWeekendTextBrush" Color="#FF9A3328" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ScheduleSelectionBrush" Color="#FF315B69" />
                    <SolidColorBrush x:Key="ScheduleSelectionTextBrush" Color="#FFE4F7FF" />
                    <SolidColorBrush x:Key="ScheduleSelectionEdgeBrush" Color="#FF8BCFE6" />
                    <SolidColorBrush x:Key="ScheduleHourLineBrush" Color="#50FFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCellBorderBrush" Color="#2BFFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCellHoverBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCellPressedBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="ScheduleWeekendBackgroundBrush" Color="#16FF6B4F" />
                    <SolidColorBrush x:Key="ScheduleWeekendTextBrush" Color="#FFFF806C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ScheduleSelectionBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ScheduleSelectionTextBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="ScheduleSelectionEdgeBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="ScheduleHourLineBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ScheduleCellBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ScheduleCellHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ScheduleCellPressedBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ScheduleWeekendBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ScheduleWeekendTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScheduleDayLabelStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style x:Key="ScheduleWeekendDayLabelStyle" BasedOn="{StaticResource ScheduleDayLabelStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ScheduleWeekendTextBrush}" />
            </Style>
            <Style x:Key="ScheduleTimeLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ScheduleTimelineStyle" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleHourLineBrush}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
            </Style>
            <Style x:Key="ScheduleWeekendTimelineStyle" BasedOn="{StaticResource ScheduleTimelineStyle}" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource ScheduleWeekendBackgroundBrush}" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style x:Key="ScheduleSlotStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleCellBorderBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <Border x:Name="SelectionIndicator" Background="Transparent" />
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                                <Border x:Name="SelectionEdge" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                                <ContentPresenter Margin="8,0,4,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" Foreground="{ThemeResource ScheduleSelectionTextBrush}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleCellHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleCellPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionEdge" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionEdgeBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionEdge" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionEdgeBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionEdge" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionEdgeBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionEdge" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionEdgeBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleSelectionBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScheduleHourSlotStyle" BasedOn="{StaticResource ScheduleSlotStyle}" TargetType="ToggleButton">
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleHourLineBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton AutomationProperties.AutomationId="Schedule.Weekly.MorningButton" x:Name="MorningButton" Click="MorningButton_Click" IsChecked="True" Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                                  FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE706;" />
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Tag="Schedule.View.Morning" Text="Morning" />
                            <TextBlock HorizontalAlignment="Center" FontSize="12" Text="00:00–12:00" />
                        </StackPanel>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton AutomationProperties.AutomationId="Schedule.Weekly.EveningButton" x:Name="EveningButton" Click="EveningButton_Click" Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                                  FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE708;" />
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Tag="Schedule.View.Evening" Text="Evening" />
                            <TextBlock HorizontalAlignment="Center" FontSize="12" Text="12:00–24:00" />
                        </StackPanel>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <TextBlock x:Name="VisibleRangeText" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="DayHeaders" Grid.Row="1" Margin="0,0,16,0" BorderBrush="{ThemeResource ScheduleHourLineBrush}" BorderThickness="0,0,0,1" />
        <ScrollViewer
            x:Name="DaysScrollViewer"
            Grid.Row="2"
            MinHeight="0"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Visible"
            VerticalScrollMode="Enabled"
            Loaded="DaysScrollViewer_Loaded"
            SizeChanged="DaysScrollViewer_SizeChanged"
            ViewChanged="DaysScrollViewer_ViewChanged">
            <Grid x:Name="DaysHost" Margin="0,0,16,0" Padding="0,8,0,24" VerticalAlignment="Top" Background="Transparent">
                <Canvas x:Name="TimeAxis" />
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="14" Height="14" VerticalAlignment="Center" Background="{ThemeResource ScheduleSelectionBrush}"
                    BorderBrush="{ThemeResource ScheduleSelectionEdgeBrush}" BorderThickness="3,0,0,0" />
            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}" Tag="Schedule.View.Legend"
                       Text="Screenshots allowed · Each row: 15 min" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
