<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ScreenshotChromeHoverBrush" Color="#140F172A" />
            <SolidColorBrush x:Key="ScreenshotChromePressedBrush" Color="#240F172A" />
            <SolidColorBrush x:Key="ScreenshotChromeCheckedFillBrush" Color="#160F172A" />
            <SolidColorBrush x:Key="ScreenshotChromeCheckedBorderBrush" Color="#407E899A" />
            <SolidColorBrush x:Key="ScreenshotSelectionFillBrush" Color="#24F9665B" />
            <SolidColorBrush x:Key="ScreenshotSelectionBorderBrush" Color="#FFF9665B" />
            <LinearGradientBrush
                x:Key="ScreenshotChromeSurfaceBrush"
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop Color="#8CFFFFFF" Offset="0" />
                <GradientStop Color="#64F4F7FB" Offset="0.48" />
                <GradientStop Color="#3CCBD5E4" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush
                x:Key="ScreenshotChromeBorderBrush"
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop Color="#E6FFFFFF" Offset="0" />
                <GradientStop Color="#A6FFFFFF" Offset="0.45" />
                <GradientStop Color="#667E899A" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ScreenshotChromeHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ScreenshotChromePressedBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ScreenshotChromeCheckedFillBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ScreenshotChromeCheckedBorderBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="ScreenshotSelectionFillBrush" Color="#3AF9665B" />
            <SolidColorBrush x:Key="ScreenshotSelectionBorderBrush" Color="#FFFF9B82" />
            <LinearGradientBrush
                x:Key="ScreenshotChromeSurfaceBrush"
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop Color="#36FFFFFF" Offset="0" />
                <GradientStop Color="#581D2128" Offset="0.48" />
                <GradientStop Color="#26000000" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush
                x:Key="ScreenshotChromeBorderBrush"
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop Color="#70FFFFFF" Offset="0" />
                <GradientStop Color="#38FFFFFF" Offset="0.45" />
                <GradientStop Color="#30000000" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ScreenshotChromeSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="ScreenshotChromeBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="ScreenshotChromeHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ScreenshotChromePressedBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ScreenshotChromeCheckedFillBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ScreenshotChromeCheckedBorderBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ScreenshotSelectionFillBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ScreenshotSelectionBorderBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="ScreenshotToolbarBaseStyle" TargetType="Control">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ScreenshotToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ScreenshotToolbarBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border
                            x:Name="InteractionOverlay"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="InteractionOverlay.Background" Value="{ThemeResource ScreenshotChromeHoverBrush}" />
                                        <Setter Target="InteractionOverlay.BorderBrush" Value="{ThemeResource ScreenshotChromeBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="InteractionOverlay.Background" Value="{ThemeResource ScreenshotChromePressedBrush}" />
                                        <Setter Target="InteractionOverlay.BorderBrush" Value="{ThemeResource ScreenshotChromeBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.40" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScreenshotToolbarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ScreenshotToolbarBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border
                            x:Name="SelectionOverlay"
                            Background="{ThemeResource ScreenshotChromeCheckedFillBrush}"
                            BorderBrush="{ThemeResource ScreenshotChromeCheckedBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0" />
                        <Border
                            x:Name="InteractionOverlay"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="InteractionOverlay.Background" Value="{ThemeResource ScreenshotChromeHoverBrush}" />
                                        <Setter Target="InteractionOverlay.BorderBrush" Value="{ThemeResource ScreenshotChromeBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="InteractionOverlay.Background" Value="{ThemeResource ScreenshotChromePressedBrush}" />
                                        <Setter Target="InteractionOverlay.BorderBrush" Value="{ThemeResource ScreenshotChromeBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.40" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ScreenshotToolbarPercentButtonStyle"
        BasedOn="{StaticResource ScreenshotToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="64" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{ThemeResource ScreenshotChromeHoverBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ScreenshotChromeBorderBrush}" />
    </Style>

    <Style
        x:Key="ScreenshotToolbarDestructiveButtonStyle"
        BasedOn="{StaticResource ScreenshotToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
</ResourceDictionary>
