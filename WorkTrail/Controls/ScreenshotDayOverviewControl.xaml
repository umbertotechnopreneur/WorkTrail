<UserControl
    x:Class="WorkTrail.Controls.ScreenshotDayOverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush
            x:Key="DayOverviewBarBrush"
            Color="{ThemeResource SystemAccentColor}"
            Opacity="0.62" />
        <SolidColorBrush
            x:Key="DayOverviewSurfaceTintBrush"
            Color="{ThemeResource SystemAccentColor}"
            Opacity="0.035" />
        <SolidColorBrush
            x:Key="DayOverviewBaselineBrush"
            Color="{ThemeResource SystemAccentColor}"
            Opacity="0.30" />
        <SolidColorBrush
            x:Key="DayOverviewSelectionBrush"
            Color="{ThemeResource SystemAccentColor}"
            Opacity="0.14" />
        <SolidColorBrush
            x:Key="DayOverviewSelectionStrokeBrush"
            Color="{ThemeResource SystemAccentColor}"
            Opacity="0.58" />
        <SolidColorBrush
            x:Key="DayOverviewSelectionLabelBrush"
            Color="{ThemeResource SystemAccentColor}"
            Opacity="0.10" />
        <Style x:Key="DayMarkerButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource DayOverviewBarBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4,4,2,2" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="SelectedDayMarkerButtonStyle" TargetType="Button" BasedOn="{StaticResource DayMarkerButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5,5,2,2" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="DayOverviewRoot"
        Height="82"
        Background="Transparent"
        Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="40" />
            <RowDefinition Height="18" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock
                VerticalAlignment="Top"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Tag="Screenshots.DayOverview.Title"
                Text="Day activity" />
            <Canvas
                x:Name="RangeLabelCanvas"
                IsHitTestVisible="False">
                <Border
                    x:Name="SelectedRangeLabel"
                    Width="160"
                    Padding="8,2"
                    Background="{StaticResource DayOverviewSelectionLabelBrush}"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="SelectedRangeText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="--"
                        TextAlignment="Center" />
                </Border>
            </Canvas>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource AcrylicInAppFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.ColumnSpan="4"
                    Background="{StaticResource DayOverviewSurfaceTintBrush}"
                    CornerRadius="9"
                    IsHitTestVisible="False" />
                <Border Grid.Column="1" Width="1" Height="26" Margin="0,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" Opacity="0.55" />
                <Border Grid.Column="2" Width="1" Height="26" Margin="0,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" Opacity="0.55" />
                <Border Grid.Column="3" Width="1" Height="26" Margin="0,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" Opacity="0.55" />
                <Canvas
                    x:Name="SelectionCanvas"
                    Grid.ColumnSpan="4"
                    IsHitTestVisible="False">
                    <Border
                        x:Name="SelectionRangeIndicator"
                        Height="30"
                        Background="{StaticResource DayOverviewSelectionBrush}"
                        BorderBrush="{StaticResource DayOverviewSelectionStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8" />
                </Canvas>
                <Border
                    x:Name="ActivityBaseline"
                    Grid.ColumnSpan="4"
                    Height="1"
                    Margin="12,0,12,6"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{StaticResource DayOverviewBaselineBrush}"
                    IsHitTestVisible="False" />
                <Canvas
                    x:Name="MarkerCanvas"
                    Grid.ColumnSpan="4"
                    SizeChanged="MarkerCanvas_SizeChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Tick0Text" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
            <TextBlock x:Name="Tick1Text" Grid.Column="1" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
            <TextBlock x:Name="Tick2Text" Grid.Column="2" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
            <TextBlock x:Name="Tick3Text" Grid.Column="3" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
            <TextBlock x:Name="Tick4Text" Grid.Column="3" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
        </Grid>
    </Grid>
</UserControl>
