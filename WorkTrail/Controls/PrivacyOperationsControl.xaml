<UserControl
    x:Class="WorkTrail.Controls.PrivacyOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="520"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowFields">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideFields">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RuleValueColumn.Width" Value="2*" />
                        <Setter Target="RuleFields.ColumnSpacing" Value="12" />
                        <Setter Target="RuleFields.RowSpacing" Value="0" />
                        <Setter Target="PrivacyRuleValueBox.(Grid.Row)" Value="0" />
                        <Setter Target="PrivacyRuleValueBox.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="NarrowActions">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideActions">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CheckActionColumn.Width" Value="*" />
                        <Setter Target="RuleActions.ColumnSpacing" Value="8" />
                        <Setter Target="RuleActions.RowSpacing" Value="0" />
                        <Setter Target="CheckActivityButton.(Grid.Row)" Value="0" />
                        <Setter Target="CheckActivityButton.(Grid.Column)" Value="1" />
                        <Setter Target="RemoveActionColumn.Width" Value="*" />
                        <Setter Target="SavedRuleActions.ColumnSpacing" Value="8" />
                        <Setter Target="SavedRuleActions.RowSpacing" Value="0" />
                        <Setter Target="RemoveRuleButton.(Grid.Row)" Value="0" />
                        <Setter Target="RemoveRuleButton.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ProgressRing x:Name="Progress" Canvas.ZIndex="1" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" IsActive="False" Visibility="Collapsed" />

        <StackPanel x:Name="SectionBody" Spacing="12">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Tag="Operations.Privacy" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Privacy" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Tag="Operations.Privacy.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Create local rules that exclude matching app names, window titles, or context details before WorkTrail stores the context or shares it with an AI provider. Review existing rules and test whether the current context would be skipped." TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="RuleFields" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="RuleValueColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ComboBox x:Name="PrivacyRuleTypeBox" Tag="Operations.PrivacyType" HorizontalAlignment="Stretch" Header="Rule type" SelectedIndex="0">
                    <ComboBoxItem Content="Process" Tag="process" />
                    <ComboBoxItem Content="Window title" Tag="title" />
                    <ComboBoxItem Content="Context" Tag="hint" />
                </ComboBox>
                <TextBox x:Name="PrivacyRuleValueBox" Grid.Row="1" Tag="Operations.PrivacyValue" Header="Value" PlaceholderText="Value to block" />
            </Grid>
            <Grid x:Name="RuleActions" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="CheckActionColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Tag="Operations.Add" Click="AddPrivacyRuleButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE710;" FontSize="16" AutomationProperties.AccessibilityView="Raw" /><TextBlock Grid.Column="1" Tag="Operations.Add" Text="Add rule" TextWrapping="Wrap" /></Grid>
                </Button>
                <Button x:Name="CheckActivityButton" Tag="Operations.TestContext" Grid.Row="1" Click="TestPrivacyButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" /><TextBlock Grid.Column="1" Tag="Operations.TestContext" Text="Check current activity" TextWrapping="Wrap" /></Grid>
                </Button>
            </Grid>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <TextBlock Tag="Operations.Privacy.Rules.Title" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Saved exclusion rules" TextWrapping="Wrap" />
            <Grid x:Name="SavedRuleActions" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="RemoveActionColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Tag="Operations.Refresh" Click="ListPrivacyRulesButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" /><TextBlock Grid.Column="1" Tag="Operations.Refresh" Text="Refresh list" TextWrapping="Wrap" /></Grid>
                </Button>
                <Button x:Name="RemoveRuleButton" Tag="Operations.Remove" Grid.Row="1" Click="RemovePrivacyRuleButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74D;" FontSize="16" AutomationProperties.AccessibilityView="Raw" /><TextBlock Grid.Column="1" Tag="Operations.Remove" Text="Remove selected rule" TextWrapping="Wrap" /></Grid>
                </Button>
            </Grid>
            <ListView x:Name="PrivacyRulesList" MinHeight="48" MaxHeight="180" AutomationProperties.Name="Configured privacy rules" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="2,5" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding TypeLabel}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="PrivacyTestText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
