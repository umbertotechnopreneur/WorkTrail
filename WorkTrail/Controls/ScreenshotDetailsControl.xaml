<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WorkTrail.Controls.ScreenshotDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ScreenshotDetailAccentBrush" Color="#FF4E8DEB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ScreenshotDetailAccentBrush" Color="#FF6AA9FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ScreenshotDetailAccentBrush" Color="#FF4E8DEB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScreenshotDetailSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="45" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ScreenshotDetailLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ScreenshotDetailValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ScreenshotDetailRowStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="0,9" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Padding="22,18,22,24" Spacing="14">
            <StackPanel x:Name="VipDetailsSection" Visibility="Collapsed" Spacing="8">
                <controls:VipBadge Tag="Snapshot.Vip.Badge" />
                <TextBlock x:Name="VipNoteLabel" Tag="Snapshot.Vip.Note" Text="Your note" FontWeight="SemiBold" />
                <TextBlock x:Name="VipNoteText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                CharacterSpacing="90"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Tag="Screenshots.Details.Title"
                Text="Snapshot details" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="50"
                    Height="50"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource ScreenshotDetailAccentBrush}"
                    BorderThickness="3"
                    CornerRadius="25">
                    <TextBlock
                        x:Name="ActivityIndexValueText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ScreenshotDetailAccentBrush}"
                        Text="--" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                        Tag="Screenshots.Details.Summary"
                        Text="Activity summary" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Tag="Screenshots.ActivityIndex.Description"
                        Text="Input activity near this capture"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CapturedAtSummaryText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="--"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="0">
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                    Tag="Screenshots.Details.Context"
                    Text="Verifiable context" />

                <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="InstallationBadge"
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            CornerRadius="15">
                            <FontIcon
                                x:Name="InstallationIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                Foreground="White"
                                Glyph="&#xE7F4;" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.Installation" Text="Installation" />
                            <TextBlock x:Name="InstallationNameValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                            <TextBlock x:Name="InstallationMachineValueText" Margin="0,1,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ScreenshotDetailAccentBrush}" Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.ApplicationLabel" Text="Foreground app" />
                            <TextBlock x:Name="ApplicationValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ScreenshotDetailAccentBrush}" Glyph="&#xE8A7;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.WindowTitle" Text="Window" />
                            <TextBlock x:Name="WindowTitleValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ScreenshotDetailAccentBrush}" Glyph="&#xE7F8;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.Screen" Text="Screen" />
                            <TextBlock x:Name="ScreenValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                            <TextBlock x:Name="CaptureKindValueText" Margin="0,1,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ScreenshotDetailAccentBrush}" Glyph="&#xE823;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.OriginLabel" Text="Capture source" />
                            <TextBlock x:Name="OriginValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                    Tag="Screenshots.Details.Privacy"
                    Text="Privacy applied" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{ThemeResource ScreenshotDetailAccentBrush}" Glyph="&#xE73E;" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Tag="Screenshots.Details.Privacy.Check"
                            Text="Capture passed privacy checks"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PrivacyStatusValueText"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="--"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Tag="Screenshots.Details.Privacy.Description"
                            Text="Protected matching contexts are excluded before capture."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="HardwareSection" Spacing="8">
                <TextBlock Style="{StaticResource ScreenshotDetailSectionTitleStyle}" Tag="Hardware.CaptureTitle" Text="Hardware at capture" />
                <TextBlock x:Name="HardwareStatusText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                <TextBlock x:Name="HardwareCollectedAtText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <ItemsControl x:Name="HardwareSummaryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4" Spacing="2">
                                <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Text="{Binding Label}" />
                                <TextBlock Style="{StaticResource ScreenshotDetailValueStyle}" Text="{Binding Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander AutomationProperties.AutomationId="Gallery.Details.AllSensors" Background="Transparent" HorizontalAlignment="Stretch" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Hardware.AllSensors" Text="All sensors" />
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="HardwareDriverStatusText" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="Hardware.PowerNote" Text="W measures component power. Battery capacity in mWh is not whole-PC energy use." TextWrapping="Wrap" />
                        <ItemsControl x:Name="HardwareSensorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalAlignment="Stretch" Background="Transparent" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Category}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Text="{Binding UpdatedAt}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Readings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,3" FontSize="12" IsTextSelectionEnabled="True" Text="{Binding}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Expander AutomationProperties.AutomationId="Gallery.Details.AnalysisSourcesExpander"
                x:Name="AnalysisSourcesExpander"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                IsExpanded="False">
                <Expander.Header>
                    <TextBlock
                        Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                        Tag="Screenshots.Details.AnalysisSources"
                        Text="Analysis and sources" />
                </Expander.Header>
                <StackPanel Padding="0,8,0,0" Spacing="14">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.SpanLabels" Text="Activity labels" />
                        <TextBlock x:Name="ActivityLabelsValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.MouseClicks" Text="Mouse" />
                                <TextBlock x:Name="MouseClicksValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Hardware.CpuInterval" Text="CPU interval avg." />
                                <TextBlock x:Name="CpuUsageValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Hardware.GpuInterval" Text="GPU interval avg." />
                                <TextBlock x:Name="GpuUsageValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="9">
                        <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.AiDescription" Text="AI description" />
                        <StackPanel x:Name="AiMarkdownHost" Spacing="8" />
                        <TextBlock
                            x:Name="NoAiDescriptionText"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Tag="Screenshots.AiDescription.Empty"
                            Text="No AI description is available for this capture."
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="AnalysisTimePanel" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                            <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="Screenshots.AiAnalyzedAt" Text="Analyzed" />
                            <TextBlock x:Name="AnalysisTimeValueText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="OcrTextSection" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.OcrText.Details.Title" Text="OCR text" />
                        <Button AutomationProperties.AutomationId="Gallery.Details.OpenOcrTextButton"
                            x:Name="OpenOcrTextButton"
                            MinHeight="36"
                            Padding="0,6"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="OpenOcrTextButton_Click"
                            Tag="Screenshots.OcrText.Details.Open"
                            AutomationProperties.Name="Open OCR text in a new window" ToolTipService.ToolTip="Open OCR text in a new window">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Tag="Screenshots.OcrText.Details.Action" Text="Open OCR text" />
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8A7;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
