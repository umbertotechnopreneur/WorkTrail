<Window
    x:Class="WorkTrail.AiConnectionTestDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Test AI provider">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleDragRegion" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Margin="24,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="15"
                    Glyph="&#xE945;" />
                <TextBlock
                    VerticalAlignment="Center"
                    CharacterSpacing="80"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Tag="AiConnectionTest.Eyebrow"
                    Text="AI PROVIDER TEST" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,18,28,20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" VerticalAlignment="Top">
                    <ProgressRing x:Name="Progress" Width="30" Height="30" IsActive="True" />
                    <FontIcon
                        x:Name="ResultIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="22"
                        Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock x:Name="TitleText" Tag="AiConnectionTest.Checking.Title" FontSize="21" FontWeight="SemiBold" Text="Checking AI provider" />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Tag="AiConnectionTest.Checking.Message"
                        Text="Sending a minimal text-only request…"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <StackPanel
                    x:Name="CountdownPanel"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="1">
                    <TextBlock
                        HorizontalAlignment="Right"
                        CharacterSpacing="80"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Tag="AiConnectionTest.TimeLeft"
                        Text="TIME LEFT" />
                    <TextBlock
                        x:Name="CountdownText"
                        HorizontalAlignment="Right"
                        FontFamily="Cascadia Mono"
                        FontSize="18"
                        FontWeight="SemiLight"
                        Text="00:30" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Border
                Grid.Row="2"
                MinHeight="178"
                Padding="16,12"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                CharacterSpacing="100"
                                FontFamily="Cascadia Mono"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="AiConnectionTest.Console"
                                Text="AI PROVIDER CONSOLE" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TerminalStateText"
                            Grid.Column="1"
                            FontFamily="Cascadia Mono"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Tag="AiConnectionTest.State.Request"
                            Text="REQUEST" />
                    </Grid>
                    <ScrollViewer
                        x:Name="TerminalScrollViewer"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="TerminalText"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            LineHeight="19"
                            TextWrapping="WrapWholeWords" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Height="1"
            VerticalAlignment="Top"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Grid Grid.Row="2" Padding="28,14,28,22">
            <Button
                x:Name="CloseButton"
                MinWidth="112"
                MinHeight="38"
                HorizontalAlignment="Right"
                Tag="AiConnectionTest.Cancel"
                Click="CloseButton_Click"
                Content="Cancel" />
        </Grid>
    </Grid>
</Window>
