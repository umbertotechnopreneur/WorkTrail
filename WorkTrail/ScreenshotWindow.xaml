<Window
    x:Class="WorkTrail.ScreenshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls"
    Title="Captured moments">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Loaded="RootGrid_Loaded"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <AcrylicBrush
                            x:Key="ScreenshotSidebarBackdropBrush"
                            FallbackColor="#EAF4F7FA"
                            TintColor="#FFF7FAFC"
                            TintLuminosityOpacity="0.16"
                            TintOpacity="0.05" />
                        <LinearGradientBrush x:Key="ScreenshotSidebarBorderBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#9AFFFFFF" Offset="0" />
                            <GradientStop Color="#28717A84" Offset="1" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="ScreenshotSidebarGripBrush" Color="#68717A84" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <AcrylicBrush
                            x:Key="ScreenshotSidebarBackdropBrush"
                            FallbackColor="#E8141920"
                            TintColor="#FF0E1319"
                            TintLuminosityOpacity="0.22"
                            TintOpacity="0.12" />
                        <LinearGradientBrush x:Key="ScreenshotSidebarBorderBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#58FFFFFF" Offset="0" />
                            <GradientStop Color="#16FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="ScreenshotSidebarGripBrush" Color="#54FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="ScreenshotSidebarBackdropBrush" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="ScreenshotSidebarBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="ScreenshotSidebarGripBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="ScreenshotTitleTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="70" />
                    <Setter Property="LineHeight" Value="18" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="TitleBarDragRegion"
            Grid.ColumnSpan="2"
            Height="48"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Style="{StaticResource ScreenshotTitleTextStyle}"
                        Tag="Screenshots.Caption"
                        Text="Captured moments" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:TimedInfoBar
            x:Name="ScreenshotActionBanner"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="40,12,40,0" />

        <controls:ScreenshotGalleryViewControl
            x:Name="GallerySection"
            Grid.Row="4"
            Grid.Column="0"
            Margin="32,0,32,14" />

        <controls:ScreenshotHeaderControl
            x:Name="HeaderSection"
            Grid.Row="2"
            Grid.Column="0"
            Margin="36,16,36,10" />

        <controls:ScreenshotDayOverviewControl
            x:Name="DayOverviewSection"
            Grid.Row="3"
            Grid.Column="0"
            Margin="0"
            Visibility="Collapsed" />

        <controls:ScreenshotTimelineControl
            x:Name="TimelineSection"
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Canvas.ZIndex="2"
            Margin="0" />

        <Border
            x:Name="DetailsPane"
            Grid.Row="2"
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="340"
            Margin="0"
            Background="{ThemeResource ScreenshotSidebarBackdropBrush}"
            BorderBrush="{ThemeResource ScreenshotSidebarBorderBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="0"
            Translation="0,0,0"
            Visibility="Collapsed">
            <Border.Transitions>
                <TransitionCollection>
                    <PaneThemeTransition Edge="Right" />
                </TransitionCollection>
            </Border.Transitions>
            <Grid>
                <controls:ScreenshotDetailsControl
                    x:Name="DetailsSection"
                    Margin="0,12,0,12" />
                <controls:HorizontalResizeGrip
                    x:Name="DetailsResizeGrip"
                    Width="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Resize snapshot details"
                    Background="Transparent"
                    IsTabStop="True"
                    KeyDown="DetailsResizeGrip_KeyDown"
                    PointerCanceled="DetailsResizeGrip_PointerCanceled"
                    PointerCaptureLost="DetailsResizeGrip_PointerCaptureLost"
                    PointerMoved="DetailsResizeGrip_PointerMoved"
                    PointerPressed="DetailsResizeGrip_PointerPressed"
                    PointerReleased="DetailsResizeGrip_PointerReleased"
                    Tag="Screenshots.Details.Resize"
                    ToolTipService.ToolTip="Resize snapshot details">
                    <controls:HorizontalResizeGrip.Template>
                        <ControlTemplate TargetType="controls:HorizontalResizeGrip">
                            <Grid Background="Transparent">
                                <Border
                                    Width="2"
                                    Height="52"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ScreenshotSidebarGripBrush}"
                                    CornerRadius="1" />
                            </Grid>
                        </ControlTemplate>
                    </controls:HorizontalResizeGrip.Template>
                </controls:HorizontalResizeGrip>
            </Grid>
        </Border>
    </Grid>
</Window>
