<Window
    x:Class="WorkTrail.SearchIndexingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Search indexing">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="1"
                Margin="16,0,0,0"
                Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,12,0"
                AutomationProperties.AccessibilityView="Raw"
                CharacterSpacing="90"
                Style="{StaticResource WorkTrailTitleBarLabelStyle}"
                Text="WORKTRAIL" />
        </Grid>

        <Grid Grid.Row="1" Padding="32,18,32,28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,3,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="30"
                    Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                    Glyph="&#xE895;" />
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock
                        x:Name="HeadingText"
                        Tag="SearchIndex.Heading"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="Rebuilding local search" />
                    <TextBlock
                        x:Name="DescriptionText"
                        Tag="SearchIndex.Description"
                        MaxWidth="560"
                        HorizontalAlignment="Left"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="WorkTrail is refreshing the local index used by search. Your activity data stays on this PC."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ProgressBar
                x:Name="OverallProgressBar"
                Grid.Row="1"
                Height="4"
                IsIndeterminate="True" />

            <Rectangle Grid.Row="2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="3" ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="22"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Tag="SearchIndex.Results.Title" FontSize="16" FontWeight="SemiBold" Text="Search results" />
                    <TextBlock
                        Tag="SearchIndex.Results.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Activity, screenshots, OCR and local descriptions"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="ResultsStateText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Indexing" />
                <ProgressBar
                    x:Name="ResultsProgressBar"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="3"
                    IsIndeterminate="True" />
            </Grid>

            <Grid Grid.Row="5" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SummaryText"
                    MaxWidth="430"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The current search index remains available until the rebuild completes."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="CancelOrCloseButton"
                    Tag="SearchIndex.Cancel"
                    Grid.Column="1"
                    MinWidth="120"
                    MinHeight="40"
                    HorizontalContentAlignment="Center"
                    Click="CancelOrCloseButton_Click"
                    Content="Cancel"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
