<Window x:Class="WorkTrail.SensorsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls" Title="WorkTrail">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="HeaderDragRegion" Background="{ThemeResource WorkTrailTitleBarOverlayBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Button AutomationProperties.AutomationId="Sensors.BackButton" x:Name="BackButton" Grid.Column="1" Margin="8,0,0,0" Click="BackButton_Click" Visibility="Collapsed"
                Tag="Sensors.Back" ToolTipService.ToolTip="Back to sensors"
                Style="{StaticResource WorkTrailTitleBarCommandButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontSize="17" AutomationProperties.AccessibilityView="Raw"/>
            </Button>
            <TextBlock x:Name="HeaderText" Grid.Column="2" Margin="16,0,12,0" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkTrailTitleBarLabelStyle}"/>
            <Button AutomationProperties.AutomationId="Sensors.OptionsButton" x:Name="OptionsButton" Grid.Column="3" Click="OptionsButton_Click" Tag="Sensors.Options.Open" ToolTipService.ToolTip="Sensor options" Style="{StaticResource WorkTrailTitleBarCommandButtonStyle}">
                <FontIcon Glyph="&#xE712;" FontSize="19" AutomationProperties.AccessibilityView="Raw"/>
            </Button>
        </Grid>
        <Grid x:Name="MonitorSurface" Grid.Row="1" Margin="24,8,24,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="0,4,0,4" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Row="1" Spacing="12" Margin="0,8,0,0">
                <TextBlock x:Name="HistoryText" Tag="Sensors.HistoryShort" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid x:Name="ColumnHeaders" ColumnSpacing="16" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/><ColumnDefinition x:Name="DeviceHeaderColumn" Width="280"/>
                        <ColumnDefinition x:Name="LoadHeaderColumn" Width="130"/><ColumnDefinition x:Name="TemperatureHeaderColumn" Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Tag="Sensors.Device" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Tag="Sensors.CurrentLoad" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Tag="Sensors.Temperature" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </StackPanel>
            <ScrollViewer x:Name="TracksViewport" Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" SizeChanged="TracksViewport_SizeChanged">
                <Grid x:Name="TracksHost" VerticalAlignment="Top"/>
            </ScrollViewer>
            <Grid Grid.Row="3" MinHeight="36" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Tag="Sensors.TemperatureHint" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel x:Name="PageNavigation" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button AutomationProperties.AutomationId="Sensors.PreviousPageButton" x:Name="PreviousPageButton" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent" BorderThickness="0" Click="PreviousPageButton_Click"
                        Tag="Sensors.PreviousPage" ToolTipService.ToolTip="Previous devices">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                    <TextBlock x:Name="PageText" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button AutomationProperties.AutomationId="Sensors.NextPageButton" x:Name="NextPageButton" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent" BorderThickness="0" Click="NextPageButton_Click"
                        Tag="Sensors.NextPage" ToolTipService.ToolTip="Next devices">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="OptionsSurface" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <controls:SensorOptionsControl x:Name="SensorOptions" Margin="24" MaxWidth="760" HorizontalAlignment="Stretch"/>
        </ScrollViewer>
    </Grid>
</Window>
