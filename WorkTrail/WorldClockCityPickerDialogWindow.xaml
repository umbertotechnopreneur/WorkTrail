<Window
    x:Class="WorkTrail.WorldClockCityPickerDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls"
    xmlns:local="using:WorkTrail"
    Title="WorkTrail">
    <Window.SystemBackdrop>
        <local:GlassBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                Margin="22,0"
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="WORKTRAIL" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="26,10,26,24"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="10">
                <TextBlock x:Name="DialogTitleText" AutomationProperties.LiveSetting="Assertive"
                           FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="WelcomeMessageText" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <controls:CityPickerControl x:Name="CityPicker" Grid.Row="1" SelectionChanged="CityPicker_SelectionChanged" />
            <TextBlock x:Name="SuggestionText" Grid.Row="2" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    Click="CancelButton_Click"
                    MinWidth="88" />
                <Button
                    x:Name="AddAnotherButton"
                    Click="AddAnotherButton_Click"
                    IsEnabled="False"
                    MinWidth="132" />
                <Button
                    x:Name="AddButton"
                    Click="AddButton_Click"
                    IsEnabled="False"
                    MinWidth="88"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <controls:TimedInfoBar
            x:Name="PickerNotificationBanner"
            Grid.RowSpan="2"
            Margin="18,54,18,0"
            VerticalAlignment="Top"
            Canvas.ZIndex="10" />
    </Grid>
</Window>
