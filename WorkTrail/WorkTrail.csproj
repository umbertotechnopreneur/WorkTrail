<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WorkTrail</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WorkTrailIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The same sources ship in two distinct deployment modes. The unpackaged
      configurations compile the bootstrapper path before WinUI is activated;
      MSIX configurations retain package-identity deployment initialization.
    -->
    <Configurations>Debug;Release;Debug-Unpackaged;Release-Unpackaged</Configurations>
    <WorkTrailDistributionMode Condition="'$(WorkTrailDistributionMode)' == '' and ('$(Configuration)' == 'Debug-Unpackaged' or '$(Configuration)' == 'Release-Unpackaged')">Unpackaged</WorkTrailDistributionMode>
    <WorkTrailDistributionMode Condition="'$(WorkTrailDistributionMode)' == ''">MSIX</WorkTrailDistributionMode>
    <WindowsPackageType Condition="'$(WorkTrailDistributionMode)' == 'Unpackaged'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(WorkTrailDistributionMode)' == 'MSIX'">MSIX</WindowsPackageType>
    <WorkTrailGeneratedMetadataPath>$(MSBuildProjectDirectory)\..\artifacts\build-metadata\$(Configuration)\$(Platform)\$(RuntimeIdentifier)</WorkTrailGeneratedMetadataPath>
    <WorkTrailVersionStatePath>$(MSBuildProjectDirectory)\..\artifacts\build-state\build-version.json</WorkTrailVersionStatePath>
    <WorkTrailBuildInfoPath>$(WorkTrailGeneratedMetadataPath)\BuildInfo.json</WorkTrailBuildInfoPath>
    <WorkTrailManifestOutputPath>$(WorkTrailGeneratedMetadataPath)\Package.appxmanifest</WorkTrailManifestOutputPath>
    <WorkTrailReleaseMetadataPath Condition="'$(WorkTrailReleaseVersion)' != ''">$(MSBuildProjectDirectory)\..\artifacts\build-metadata\release\$(WorkTrailReleaseVersion)\$(Platform)</WorkTrailReleaseMetadataPath>
    <WorkTrailBuildInfoPath Condition="'$(WorkTrailReleaseVersion)' != ''">$(WorkTrailReleaseMetadataPath)\BuildInfo.json</WorkTrailBuildInfoPath>
    <WorkTrailManifestOutputPath Condition="'$(WorkTrailReleaseVersion)' != ''">$(WorkTrailReleaseMetadataPath)\Package.appxmanifest</WorkTrailManifestOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="$(WorkTrailManifestOutputPath)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\WorkTrail*.png" />
    <Content Update="Assets\WorkTrailExcelPreview.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Assets\WorkTrailNuclearize.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\WorkTrailIcon.ico" />
    <Content Include="Assets\Celestial\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\WorldClocks\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\design\branding\recall-timeline\output\worktrail-recall-timeline-banner-theme-dark-readme-2400x800.png">
      <Link>Assets\WorkTrailAboutHero.theme-dark.png</Link>
      <TargetPath>Assets\WorkTrailAboutHero.theme-dark.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\design\branding\recall-timeline\output\worktrail-recall-timeline-banner-theme-light-readme-2400x800.png">
      <Link>Assets\WorkTrailAboutHero.theme-light.png</Link>
      <TargetPath>Assets\WorkTrailAboutHero.theme-light.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(WorkTrailBuildInfoPath)" Link="BuildInfo.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateWorkTrailBuildInformation" BeforeTargets="PrepareForBuild">
    <!-- Environment transport keeps the release version out of shell interpolation. -->
    <Exec EnvironmentVariables="WORKTRAIL_RELEASE_VERSION=$(WorkTrailReleaseVersion)" Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\scripts\WorkTrail.ps1&quot; -Action BuildInfo -VersionStatePath &quot;$(WorkTrailVersionStatePath)&quot; -OutputPath &quot;$(WorkTrailBuildInfoPath)&quot; -PackageManifestPath &quot;$(MSBuildProjectDirectory)\Package.appxmanifest&quot; -PackageManifestOutputPath &quot;$(WorkTrailManifestOutputPath)&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot;" />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="6.9.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- ReadyToRun currently produces an unpackaged .NET 10 client whose Windows App SDK
         auto-initializer cannot resolve System.Environment. Keep it disabled until that
         toolchain combination is validated on every supported architecture. -->
    <PublishReadyToRun>False</PublishReadyToRun>
    <!-- WinUI, the runtime IPC catalog, and persisted settings use runtime JSON type discovery.
         Keep trimming disabled until those contracts are fully source-generated; a trimmed
         Release-Unpackaged client otherwise terminates before the main window is created. -->
    <PublishTrimmed>False</PublishTrimmed>
    <DebugSymbols Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">False</DebugSymbols>
    <DebugType Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">none</DebugType>
    <AppxSymbolPackageEnabled Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">False</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <Target Name="RemoveSideloadSymbolPayload" BeforeTargets="_EnsurePdbCmfExeFullPath" Condition="'$(GenerateAppxPackageOnBuild)' == 'true' and '$(AppxSymbolPackageEnabled)' != 'true'">
    <ItemGroup>
      <PDBPayload Remove="@(PDBPayload)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\WorkTrail.Core\WorkTrail.Core.csproj" />
    <ProjectReference Include="..\WorkTrail.Cli\WorkTrail.Cli.csproj" />
    <ProjectReference Include="..\WorkTrail.Presentation\WorkTrail.Presentation.csproj" />
    <ProjectReference Include="..\WorkTrail.Taskbar\WorkTrail.Taskbar.csproj" />
    <ProjectReference Include="..\WorkTrail.Hardware\WorkTrail.Hardware.csproj" ReferenceOutputAssembly="false" OutputItemType="_HardwareCollectorTarget" />
  </ItemGroup>

  <Target Name="IncludeHardwareCollector" AfterTargets="ResolveProjectReferences" Condition="'@(_HardwareCollectorTarget)' != ''">
    <!-- Keep the sensor-only executable and its dependency closure together in both deployment modes. -->
    <PropertyGroup>
      <_HardwareCollectorDirectory>@(_HardwareCollectorTarget->'%(RootDir)%(Directory)')</_HardwareCollectorDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_HardwareCollectorDirectory)\WorkTrail.Hardware.exe')" Text="The hardware collector executable was not built." />
    <Error Condition="'$(Platform)' == 'x64' and !Exists('$(_HardwareCollectorDirectory)\PawnIO\PawnIO_setup.exe')" Text="The bundled PawnIO installer is missing from the x64 hardware output." />
    <ItemGroup>
      <_HardwareCollectorFile Include="$(_HardwareCollectorDirectory)\**\*" Exclude="$(_HardwareCollectorDirectory)\**\*.pdb" />
      <ContentWithTargetPath Include="@(_HardwareCollectorFile)">
        <Link>Hardware\%(_HardwareCollectorFile.RecursiveDir)%(_HardwareCollectorFile.Filename)%(_HardwareCollectorFile.Extension)</Link>
        <TargetPath>Hardware\%(_HardwareCollectorFile.RecursiveDir)%(_HardwareCollectorFile.Filename)%(_HardwareCollectorFile.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Providers\**\*.cs" />
  </ItemGroup>

</Project>
