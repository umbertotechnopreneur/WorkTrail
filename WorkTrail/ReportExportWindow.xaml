<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WorkTrail.ReportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WorkTrail.Controls" Title="WorkTrail">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="SummaryActionIconBrush" Color="#7040A0" />
                        <SolidColorBrush x:Key="SaveActionIconBrush" Color="#26765B" />
                        <SolidColorBrush x:Key="WeekActionIconBrush" Color="#315EA3" />
                        <SolidColorBrush x:Key="ExportActionIconBrush" Color="#6C3318" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="SummaryActionIconBrush" Color="#C7A0FF" />
                        <SolidColorBrush x:Key="SaveActionIconBrush" Color="#6ED1B3" />
                        <SolidColorBrush x:Key="WeekActionIconBrush" Color="#91B8FF" />
                        <SolidColorBrush x:Key="ExportActionIconBrush" Color="#6C3318" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="SummaryActionIconBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                        <StaticResource x:Key="SaveActionIconBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                        <StaticResource x:Key="WeekActionIconBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                        <StaticResource x:Key="ExportActionIconBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="TitleDragRegion">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Margin="24,0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="WORKTRAIL" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150" />
                <controls:PremiumBadge x:Name="TitlePremiumBadge" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Auto" OpenPaneLength="192" ExpandedModeThresholdWidth="1050" CompactModeThresholdWidth="720"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ExportTab" Icon="Save" Tag="Export.Tab" />
                <NavigationViewItem x:Name="ContentsTab" Icon="Bullets" Tag="Export.Contents" />
                <NavigationViewItem x:Name="SummaryTab" Icon="Edit" Tag="Export.AiSummary" />
                <NavigationViewItem x:Name="TimesheetTab" Icon="Calendar" Tag="Timesheet.Title" />
            </NavigationView.MenuItems>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="BodyGrid" Margin="24,8,24,24" ColumnSpacing="28" RowSpacing="24" SizeChanged="BodyGrid_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="2*" /><ColumnDefinition x:Name="PreviewColumn" Width="3*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="EditorPanel" Spacing="20">
                        <StackPanel x:Name="ExportPage" Spacing="20">
                            <TextBlock Tag="Export.Title" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Tag="Export.Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TodayButton" Tag="Export.Today" Click="Today_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BF;" FontSize="16"
                                                  Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Tag="Export.Today" Text="Today" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WeekButton" Tag="Export.Week" Click="Week_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C0;" FontSize="16"
                                                  Foreground="{ThemeResource WeekActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Tag="Export.Week" Text="7 days" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MonthButton" Tag="Export.Month" Click="Month_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE787;" FontSize="16"
                                                  Foreground="{ThemeResource SummaryActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Tag="Export.Month" Text="This month" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <CalendarDatePicker x:Name="FromPicker" HorizontalAlignment="Stretch" DateChanged="DateChanged" />
                            <CalendarDatePicker x:Name="ToPicker" HorizontalAlignment="Stretch" DateChanged="DateChanged" />
                            <TextBlock x:Name="TimeZoneText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <ComboBox x:Name="DevicesCombo" Tag="Export.Devices" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                            <ComboBox x:Name="FormatCombo" Tag="Export.Format" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                            <TextBlock x:Name="FormatHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="ContentsPage" Visibility="Collapsed" Spacing="10">
                            <TextBlock Tag="Export.Contents" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <CheckBox x:Name="DaysCheck" Tag="Export.Days" Click="OptionsChanged" />
                            <CheckBox x:Name="ApplicationsCheck" Tag="Export.Applications" Click="OptionsChanged" />
                            <CheckBox x:Name="CapturesCheck" Tag="Export.Captures" Click="OptionsChanged" />
                            <CheckBox x:Name="TelemetryCheck" Tag="Export.Telemetry" Click="OptionsChanged" />
                            <CheckBox x:Name="UsageCheck" Tag="Export.AiUsage" Click="OptionsChanged" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                            <CheckBox x:Name="DescriptionsCheck" Tag="Export.SavedDescriptions" Click="OptionsChanged" />
                            <ComboBox x:Name="DescriptionCombo" Tag="Export.DescriptionMode" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                            <TextBlock Tag="Export.ExcerptHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <CheckBox x:Name="OcrCheck" Tag="Export.Ocr" Click="OptionsChanged" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                            <CheckBox x:Name="TitlesCheck" Tag="Export.Titles" Click="OptionsChanged" />
                            <CheckBox x:Name="DevicesCheck" Tag="Export.DeviceNames" Click="OptionsChanged" />
                            <CheckBox x:Name="PathsCheck" Tag="Export.Paths" Click="OptionsChanged" />
                            <TextBlock Tag="Export.PrivacyHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="SeparatorCombo" Tag="Export.Separator" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                        </StackPanel>
                        <StackPanel x:Name="SummaryPage" Visibility="Collapsed" Spacing="14">
                            <TextBlock Tag="Export.AiSummary" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Tag="Timesheet.SummaryIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="GroupingCombo" Tag="Export.Grouping" HorizontalAlignment="Stretch" SelectionChanged="SummaryOptionsChanged" />
                            <HyperlinkButton x:Name="GroupingInfoLink" Tag="Export.MoreInformation" Content="More information" Click="GroupingInfo_Click" Padding="0" />
                            <CheckBox x:Name="DetailedCheck" Tag="Export.Detailed" Click="SummaryOptionsChanged" />
                            <CheckBox x:Name="IncludeSummaryCheck" Tag="Export.IncludeSummary" />
                            <TextBlock Tag="Export.SavedDescriptions" TextWrapping="Wrap" />
                            <CheckBox x:Name="SummaryExcerptCheck" Tag="Export.Brief" IsChecked="True" Margin="16,0,0,0" Click="SummaryOptionsChanged" />
                            <CheckBox x:Name="SummaryFullDescriptionCheck" Tag="Export.CompleteText" Margin="16,0,0,0" Click="SummaryOptionsChanged" />
                            <CheckBox x:Name="SummaryOcrCheck" Tag="Export.Ocr" Click="SummaryOptionsChanged" />
                            <CheckBox x:Name="SummaryTitlesCheck" Tag="Export.Titles" Click="SummaryOptionsChanged" />
                            <TextBlock x:Name="ProviderText" TextWrapping="Wrap" />
                            <TextBlock Tag="Export.AiNotice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Tag="Export.MoreInformation" Content="More information" Click="SummaryInfo_Click" />
                                <Button x:Name="GenerateButton" Tag="Export.Generate" Click="Generate_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SummaryActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Tag="Export.Generate" Text="Generate summary" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="TimesheetPage" Visibility="Collapsed" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Tag="Timesheet.Title" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <controls:PremiumBadge x:Name="TimesheetPremiumBadge" />
                            </StackPanel>
                            <TextBlock Tag="Timesheet.Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TimesheetRange" TextWrapping="Wrap" />
                            <CheckBox x:Name="TimesheetMergeCheck" Click="TimesheetOptionsChanged" Tag="Timesheet.Merge" IsChecked="True" />
                            <TextBlock Tag="Timesheet.GroupingHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <CheckBox x:Name="TimesheetMonthsCheck" Click="TimesheetOptionsChanged" Tag="Timesheet.Months" />
                            <TextBox x:Name="TimesheetConsultant" TextChanged="TimesheetOptionsChanged" Tag="Timesheet.Consultant" MaxLength="120" />
                            <TextBox x:Name="TimesheetClient" TextChanged="TimesheetOptionsChanged" Tag="Timesheet.Client" MaxLength="120" />
                            <CheckBox x:Name="TimesheetBillingCheck" Click="TimesheetOptionsChanged" Tag="Timesheet.Billing" />
                            <NumberBox x:Name="TimesheetRate" Tag="Timesheet.Rate" Value="0" Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Compact" />
                            <TextBox x:Name="TimesheetCurrency" TextChanged="TimesheetOptionsChanged" Tag="Timesheet.Currency" Text="EUR" MaxLength="3" />
                            <TextBlock Tag="Timesheet.Sources" FontWeight="SemiBold" />
                            <CheckBox x:Name="TimesheetDescriptions" Click="TimesheetOptionsChanged" Tag="Export.SavedDescriptions" IsChecked="True" />
                            <CheckBox x:Name="TimesheetOcr" Click="TimesheetOptionsChanged" Tag="Export.Ocr" />
                            <CheckBox x:Name="TimesheetTitles" Click="TimesheetOptionsChanged" Tag="Export.Titles" />
                            <TextBlock Tag="Timesheet.Notice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Tag="Timesheet.Submit" Content="Submit batch" Click="TimesheetStart_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ResultsPanel" Grid.Column="1" Spacing="14">
                        <Border CornerRadius="12" MinHeight="250" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Border.Background><ImageBrush ImageSource="ms-appx:///Assets/WorkTrailExcelPreview.png" Stretch="UniformToFill" /></Border.Background>
                            <StackPanel Margin="22" Spacing="12" MaxWidth="245" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Tag="Timesheet.PreviewTitle" FontSize="23" FontWeight="SemiBold" Foreground="#173C2D" TextWrapping="Wrap" />
                                <TextBlock Tag="Timesheet.PreviewHelp" Foreground="#173C2D" TextWrapping="Wrap" />
                                <Button Tag="Timesheet.OpenPreview" Content="Open Excel preview" Click="ExcelPreview_Click" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="TimesheetJobsPanel" Visibility="Collapsed" Spacing="14">
                            <ComboBox x:Name="TimesheetJobs" Tag="Timesheet.Jobs" HorizontalAlignment="Stretch" SelectionChanged="TimesheetJobs_SelectionChanged" />
                            <TextBlock x:Name="TimesheetStatus" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <Button Tag="Timesheet.Refresh" Content="Refresh status" Click="TimesheetRefresh_Click" />
                            <Button x:Name="TimesheetCancelButton" Tag="Timesheet.Cancel" Content="Cancel cloud batch" Click="TimesheetCancel_Click" IsEnabled="False" />
                            <TextBlock Tag="Timesheet.ReviewNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="TimesheetExportButton" Tag="Timesheet.Export" Content="Save Excel" Click="TimesheetExport_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
        <StackPanel Grid.Row="2" Margin="24,0" Spacing="4">
            <ProgressBar x:Name="BusyBar" Visibility="Collapsed" IsIndeterminate="True" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <Grid x:Name="FooterGrid" Grid.Row="3" Padding="24,16" ColumnSpacing="10" RowSpacing="10" SizeChanged="FooterGrid_SizeChanged" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="PreferenceActions" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Tag="Export.SavePreset" Click="Save_Click">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Tag="Export.SavePreset" Text="Save preferences" TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button x:Name="CancelButton" Tag="Export.Cancel" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Tag="About.Close" Content="Close" Click="Close_Click" />
            <Button Grid.Column="2" x:Name="ExportButton" Tag="Export.Action" Style="{StaticResource AccentButtonStyle}" Click="Export_Click" MinWidth="110">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ExportActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Tag="Export.Action" Text="Export…" TextWrapping="Wrap" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
