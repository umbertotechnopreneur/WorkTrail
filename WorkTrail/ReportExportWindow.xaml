<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WorkTrail.ReportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WorkTrail.Controls" Title="WorkTrail">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="SummaryActionIconBrush" Color="#7040A0" />
                        <SolidColorBrush x:Key="SaveActionIconBrush" Color="#26765B" />
                        <SolidColorBrush x:Key="WeekActionIconBrush" Color="#315EA3" />
                        <SolidColorBrush x:Key="ExportActionIconBrush" Color="#6C3318" />
                        <ImageBrush x:Key="ExcelPreviewBackground" ImageSource="ms-appx:///Assets/WorkTrailExcelPreviewLight.png" Stretch="UniformToFill" />
                        <SolidColorBrush x:Key="ExcelPreviewForeground" Color="#173C2D" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="SummaryActionIconBrush" Color="#C7A0FF" />
                        <SolidColorBrush x:Key="SaveActionIconBrush" Color="#6ED1B3" />
                        <SolidColorBrush x:Key="WeekActionIconBrush" Color="#91B8FF" />
                        <SolidColorBrush x:Key="ExportActionIconBrush" Color="#6C3318" />
                        <ImageBrush x:Key="ExcelPreviewBackground" ImageSource="ms-appx:///Assets/WorkTrailExcelPreviewDark.png" Stretch="UniformToFill" />
                        <SolidColorBrush x:Key="ExcelPreviewForeground" Color="#DCF5E6" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="SummaryActionIconBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                        <StaticResource x:Key="SaveActionIconBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                        <StaticResource x:Key="WeekActionIconBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                        <StaticResource x:Key="ExportActionIconBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                        <StaticResource x:Key="ExcelPreviewBackground" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="ExcelPreviewForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="ReportOptionCheckBoxStyle" TargetType="CheckBox">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="TitleDragRegion">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Margin="24,0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="WORKTRAIL" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150" />
                <controls:PremiumBadge x:Name="TitlePremiumBadge" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Auto" OpenPaneLength="192" ExpandedModeThresholdWidth="1050" CompactModeThresholdWidth="720"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="Report.ExportTab" x:Name="ExportTab" Icon="Save" Tag="Export.Tab" />
                <NavigationViewItem AutomationProperties.AutomationId="Report.ContentsTab" x:Name="ContentsTab" Icon="Bullets" Tag="Export.Contents" />
                <NavigationViewItem AutomationProperties.AutomationId="Report.SummaryTab" x:Name="SummaryTab" Icon="Edit" Tag="Export.AiSummary" />
                <NavigationViewItem AutomationProperties.AutomationId="Report.TimesheetTab" x:Name="TimesheetTab" Icon="Calendar" Tag="Timesheet.Title" />
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="BodyScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled" SizeChanged="BodyScrollViewer_SizeChanged">
                <Grid x:Name="BodyGrid" Margin="24,8,24,24" ColumnSpacing="28" RowSpacing="24" SizeChanged="BodyGrid_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="2*" /><ColumnDefinition x:Name="PreviewColumn" Width="3*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="EditorPanel" Spacing="20">
                        <StackPanel x:Name="ExportPage" Spacing="20">
                            <TextBlock Tag="Export.Title" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Tag="Export.Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button AutomationProperties.AutomationId="Report.TodayButton" x:Name="TodayButton" Tag="Export.Today" Click="Today_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BF;" FontSize="16"
                                                  Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Tag="Export.Today" Text="Today" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                                <Button AutomationProperties.AutomationId="Report.WeekButton" x:Name="WeekButton" Grid.Column="1" Tag="Export.Week" Click="Week_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C0;" FontSize="16"
                                                  Foreground="{ThemeResource WeekActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Tag="Export.Week" Text="7 days" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                                <Button AutomationProperties.AutomationId="Report.MonthButton" x:Name="MonthButton" Grid.Column="2" Tag="Export.Month" Click="Month_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE787;" FontSize="16"
                                                  Foreground="{ThemeResource SummaryActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Tag="Export.Month" Text="This month" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CalendarDatePicker AutomationProperties.AutomationId="Report.FromPicker" x:Name="FromPicker" MinWidth="0" HorizontalAlignment="Stretch" DateChanged="DateChanged" />
                                <CalendarDatePicker AutomationProperties.AutomationId="Report.ToPicker" x:Name="ToPicker" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" DateChanged="DateChanged" />
                                <ComboBox AutomationProperties.AutomationId="Report.DevicesCombo" x:Name="DevicesCombo" Grid.Row="1" Tag="Export.Devices" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                                <ComboBox AutomationProperties.AutomationId="Report.FormatCombo" x:Name="FormatCombo" Grid.Row="1" Grid.Column="1" Tag="Export.Format" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                            </Grid>
                            <TextBlock x:Name="TimeZoneText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="FormatHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="WorkbookThemeCombo" AutomationProperties.AutomationId="Report.WorkbookTheme"
                                      Tag="Export.ExcelTheme" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                            <TextBlock Tag="Export.ExcelThemeHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="ContentsPage" Visibility="Collapsed" Spacing="14">
                            <TextBlock Tag="Export.Contents" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Grid ColumnSpacing="18" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CheckBox AutomationProperties.AutomationId="Report.DaysCheck" x:Name="DaysCheck" Tag="Export.Days" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.ApplicationsCheck" x:Name="ApplicationsCheck" Grid.Column="1" Tag="Export.Applications" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.CapturesCheck" x:Name="CapturesCheck" Grid.Row="1" Tag="Export.Captures" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.TelemetryCheck" x:Name="TelemetryCheck" Grid.Row="1" Grid.Column="1" Tag="Export.Telemetry" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.UsageCheck" x:Name="UsageCheck" Grid.Row="2" Tag="Export.AiUsage" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.TitlesCheck" x:Name="TitlesCheck" Grid.Row="2" Grid.Column="1" Tag="Export.Titles" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.DevicesCheck" x:Name="DevicesCheck" Grid.Row="3" Tag="Export.DeviceNames" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.PathsCheck" x:Name="PathsCheck" Grid.Row="3" Grid.Column="1" Tag="Export.Paths" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            </Grid>
                            <ComboBox AutomationProperties.AutomationId="Report.SeparatorCombo" x:Name="SeparatorCombo" Tag="Export.Separator" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                        </StackPanel>
                        <StackPanel x:Name="SummaryPage" Visibility="Collapsed" Spacing="14">
                            <TextBlock Tag="Export.AiSummary" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Tag="Export.SummaryIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox AutomationProperties.AutomationId="Report.GroupingCombo" x:Name="GroupingCombo" Tag="Export.Grouping" HorizontalAlignment="Stretch" SelectionChanged="SummaryOptionsChanged" />
                            <HyperlinkButton AutomationProperties.AutomationId="Report.GroupingInfoLink" x:Name="GroupingInfoLink" Tag="Export.MoreInformation" Content="More information" Click="GroupingInfo_Click" Padding="0" />
                            <CheckBox AutomationProperties.AutomationId="Report.DetailedCheck" x:Name="DetailedCheck" Tag="Export.Detailed" Click="SummaryOptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            <CheckBox AutomationProperties.AutomationId="Report.IncludeSummaryCheck" x:Name="IncludeSummaryCheck" Tag="Export.IncludeSummary" Click="ExcelPreviewOptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            <TextBlock Tag="Export.SavedDescriptions" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CheckBox AutomationProperties.AutomationId="Report.SummaryExcerptCheck" x:Name="SummaryExcerptCheck" Tag="Export.Brief" IsChecked="True" Click="SummaryOptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.SummaryFullDescriptionCheck" x:Name="SummaryFullDescriptionCheck" Grid.Column="1" Tag="Export.CompleteText" Click="SummaryOptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.SummaryOcrCheck" x:Name="SummaryOcrCheck" Grid.Row="1" Tag="Export.Ocr" Click="SummaryOptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.SummaryTitlesCheck" x:Name="SummaryTitlesCheck" Grid.Row="1" Grid.Column="1" Tag="Export.Titles" Click="SummaryOptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            </Grid>
                            <TextBlock x:Name="ProviderText" TextWrapping="Wrap" />
                            <TextBlock Tag="Export.AiNotice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="Report.MoreInformation" Tag="Export.MoreInformation" Content="More information" Click="SummaryInfo_Click" />
                                <Button AutomationProperties.AutomationId="Report.GenerateButton" x:Name="GenerateButton" Tag="Export.Generate" Click="Generate_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SummaryActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Tag="Export.Generate" Text="Generate summary" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="TimesheetPage" Visibility="Collapsed" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Tag="Timesheet.Title" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <controls:PremiumBadge x:Name="TimesheetPremiumBadge" />
                            </StackPanel>
                            <TextBlock x:Name="TimesheetRange" TextWrapping="Wrap" />
                            <ComboBox x:Name="TimesheetGroupingCombo" AutomationProperties.AutomationId="Report.TimesheetGrouping"
                                      Tag="Timesheet.Grouping" HorizontalAlignment="Stretch" SelectionChanged="TimesheetGrouping_SelectionChanged" />
                            <CheckBox AutomationProperties.AutomationId="Report.TimesheetMergeCheck" x:Name="TimesheetMergeCheck" Click="TimesheetOptionsChanged" Tag="Timesheet.Merge" IsChecked="True" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            <CheckBox AutomationProperties.AutomationId="Report.TimesheetMonthsCheck" x:Name="TimesheetMonthsCheck" Click="TimesheetOptionsChanged" Tag="Timesheet.Months" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            <Grid ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBox AutomationProperties.AutomationId="Report.TimesheetConsultant" x:Name="TimesheetConsultant" TextChanged="TimesheetOptionsChanged" Tag="Timesheet.Consultant" MaxLength="120" HorizontalAlignment="Stretch" />
                                <TextBox AutomationProperties.AutomationId="Report.TimesheetClient" x:Name="TimesheetClient" Grid.Column="1" TextChanged="TimesheetOptionsChanged" Tag="Timesheet.Client" MaxLength="120" HorizontalAlignment="Stretch" />
                                <NumberBox AutomationProperties.AutomationId="Report.TimesheetRate" x:Name="TimesheetRate" Grid.Row="1" Tag="Timesheet.Rate" Value="0" Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" />
                                <TextBox AutomationProperties.AutomationId="Report.TimesheetCurrency" x:Name="TimesheetCurrency" Grid.Row="1" Grid.Column="1" TextChanged="TimesheetOptionsChanged" Tag="Timesheet.Currency" Text="EUR" MaxLength="3" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Tag="Timesheet.MetadataHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <CheckBox AutomationProperties.AutomationId="Report.TimesheetBillingCheck" x:Name="TimesheetBillingCheck" Click="TimesheetOptionsChanged" Tag="Timesheet.Billing" />
                            <TextBlock Tag="Timesheet.Sources" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CheckBox AutomationProperties.AutomationId="Report.TimesheetDescriptions" x:Name="TimesheetDescriptions" Click="TimesheetOptionsChanged" Tag="Export.SavedDescriptions" IsChecked="True" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.TimesheetOcr" x:Name="TimesheetOcr" Grid.Column="1" Click="TimesheetOptionsChanged" Tag="Export.Ocr" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.TimesheetTitles" x:Name="TimesheetTitles" Grid.Row="1" Click="TimesheetOptionsChanged" Tag="Export.Titles" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                            </Grid>
                            <Button AutomationProperties.AutomationId="Report.Timesheet_Submit" Tag="Timesheet.Submit" Click="TimesheetStart_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SummaryActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Tag="Timesheet.Submit" Text="Submit batch" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ResultsPanel" Grid.Column="1" Spacing="14">
                        <StackPanel x:Name="ReportWelcomePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Tag="Export.WelcomeTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Tag="Export.WelcomeIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Expander x:Name="ExcelPreviewExpander" AutomationProperties.AutomationId="Report.ExcelPreviewExpander"
                                  IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Tag="Timesheet.PreviewTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button x:Name="ExcelPreviewGenerateButton" AutomationProperties.AutomationId="Report.Timesheet_OpenPreview"
                                            Grid.Column="1" Tag="Timesheet.GeneratePreview" Click="ExcelPreview_Click"
                                            Style="{StaticResource AccentButtonStyle}" MinHeight="40" Padding="14,8" FontWeight="SemiBold">
                                        <TextBlock Tag="Timesheet.GeneratePreview" Text="Generate Excel preview" TextWrapping="Wrap" />
                                    </Button>
                                </Grid>
                            </Expander.Header>
                            <Border CornerRadius="8" Background="{ThemeResource ExcelPreviewBackground}" Padding="18" MinHeight="150">
                                <TextBlock Tag="Timesheet.PreviewHelp" Foreground="{ThemeResource ExcelPreviewForeground}"
                                           TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </Expander>
                        <StackPanel x:Name="ExcelPreviewStatusPanel" Visibility="Collapsed" Spacing="12" Margin="0,6,0,10">
                            <TextBlock x:Name="ExcelPreviewStatus" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ProgressBar x:Name="ExcelPreviewProgress" IsIndeterminate="True" Visibility="Collapsed" />
                            <StackPanel x:Name="ExcelPreviewFilePanel" Visibility="Collapsed" Spacing="8">
                                <TextBlock Tag="Timesheet.PreviewPath" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="ExcelPreviewPath" AutomationProperties.AutomationId="Report.ExcelPreviewPath"
                                         IsReadOnly="True" TextWrapping="Wrap" HorizontalAlignment="Stretch" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button x:Name="ExcelPreviewOpenButton" AutomationProperties.AutomationId="Report.ExcelPreviewOpen"
                                            Tag="Timesheet.OpenPreview" Click="ExcelPreviewOpen_Click"
                                            Style="{StaticResource AccentButtonStyle}" MinHeight="44" Padding="18,10">
                                        <TextBlock Tag="Timesheet.OpenPreview" Text="Open Excel preview" TextWrapping="Wrap" />
                                    </Button>
                                    <Button x:Name="ExcelPreviewCopyButton" AutomationProperties.AutomationId="Report.ExcelPreviewCopy"
                                            Grid.Column="1" Click="ExcelPreviewCopy_Click" MinWidth="44" MinHeight="44">
                                        <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        <Grid x:Name="ReportTabHelpPanel" Visibility="Collapsed" ColumnSpacing="20" RowSpacing="18" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Tag="Export.Tab" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Tag="Export.WelcomeExportHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource WeekActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Tag="Export.Contents" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Tag="Export.WelcomeContentsHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SummaryActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Tag="Export.AiSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Tag="Export.WelcomeSummaryHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Tag="Timesheet.Title" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Tag="Export.WelcomeTimesheetHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ContentsDetailsPage" Visibility="Collapsed" Spacing="14" Margin="0,8,0,0">
                            <Grid ColumnSpacing="18" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CheckBox AutomationProperties.AutomationId="Report.DescriptionsCheck" x:Name="DescriptionsCheck" Tag="Export.SavedDescriptions" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <CheckBox AutomationProperties.AutomationId="Report.OcrCheck" x:Name="OcrCheck" Grid.Column="1" Tag="Export.Ocr" Click="OptionsChanged" Style="{StaticResource ReportOptionCheckBoxStyle}" />
                                <ComboBox AutomationProperties.AutomationId="Report.DescriptionCombo" x:Name="DescriptionCombo" Grid.Row="1" Grid.ColumnSpan="2" Tag="Export.DescriptionMode" HorizontalAlignment="Stretch" SelectionChanged="OptionsChanged" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Tag="Export.ExcerptHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Tag="Export.PrivacyHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid x:Name="SummaryEditorPanel" Visibility="Collapsed" MinHeight="420" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Tag="Export.Editable.Header" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBox x:Name="SummaryTextBox" AutomationProperties.AutomationId="Report.SummaryTextBox"
                                     Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     TextChanged="SummaryTextBox_TextChanged" />
                            <TextBlock Grid.Row="2" Tag="Export.ReviewSummary" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel x:Name="TimesheetEmptyInfo" Visibility="Collapsed" Spacing="18" Margin="0,8,0,0">
                            <TextBlock Tag="Timesheet.BatchHelpTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Tag="Timesheet.Intro" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{ThemeResource SaveActionIconBrush}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Tag="Timesheet.Notice" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{ThemeResource WeekActionIconBrush}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Tag="Timesheet.GroupingHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="TimesheetJobsPanel" Visibility="Collapsed" Spacing="14">
                            <ComboBox AutomationProperties.AutomationId="Report.TimesheetJobs" x:Name="TimesheetJobs" Tag="Timesheet.Jobs" HorizontalAlignment="Stretch" SelectionChanged="TimesheetJobs_SelectionChanged" />
                            <StackPanel x:Name="TimesheetPaginationPanel" Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="Report.TimesheetPreviousButton" x:Name="TimesheetPreviousButton" Tag="Timesheet.PreviousPage" Click="TimesheetPrevious_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource WeekActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Tag="Timesheet.PreviousPage" Text="Previous" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.AutomationId="Report.TimesheetNextButton" x:Name="TimesheetNextButton" Tag="Timesheet.NextPage" Click="TimesheetNext_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Tag="Timesheet.NextPage" Text="Next" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource WeekActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="TimesheetStatus" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <Button AutomationProperties.AutomationId="Report.Timesheet_Refresh" Tag="Timesheet.Refresh" Click="TimesheetRefresh_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource WeekActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Tag="Timesheet.Refresh" Text="Refresh status" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="Report.TimesheetCancelButton" x:Name="TimesheetCancelButton" Tag="Timesheet.Cancel" Click="TimesheetCancel_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource BrandCoralBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Tag="Timesheet.Cancel" Text="Cancel cloud batch" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Tag="Timesheet.ReviewNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Tag="Timesheet.GroupingHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Tag="Timesheet.Notice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button AutomationProperties.AutomationId="Report.TimesheetExportButton" x:Name="TimesheetExportButton" Tag="Timesheet.Export" Click="TimesheetExport_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Tag="Timesheet.Export" Text="Save Excel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
        <StackPanel Grid.Row="2" Margin="24,0" Spacing="4">
            <ProgressBar x:Name="BusyBar" Visibility="Collapsed" IsIndeterminate="True" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <Grid x:Name="FooterGrid" Grid.Row="3" Padding="24,16" ColumnSpacing="10" RowSpacing="10" SizeChanged="FooterGrid_SizeChanged" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="PreferenceActions" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="Report.SaveButton" x:Name="SaveButton" Tag="Export.SavePreset" Click="Save_Click">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SaveActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Tag="Export.SavePreset" Text="Save preferences" TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button AutomationProperties.AutomationId="Report.CancelButton" x:Name="CancelButton" Tag="Export.Cancel" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />
            </StackPanel>
            <Button AutomationProperties.AutomationId="Report.Close" Grid.Column="1" x:Name="CloseButton" Tag="About.Close" Content="Close" Click="Close_Click" />
            <Button AutomationProperties.AutomationId="Report.Export" Grid.Column="2" x:Name="ExportButton" Tag="Export.Action" Style="{StaticResource AccentButtonStyle}" Click="Export_Click" MinWidth="110">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ExportActionIconBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Tag="Export.Action" Text="Export…" TextWrapping="Wrap" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
