<Window
    x:Class="WorkTrail.AiPricingDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTrail">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <Style x:Key="SummaryLabelStyle"
                   TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize"
                        Value="13"/>
                <Setter Property="TextWrapping"
                        Value="WrapWholeWords"/>
            </Style>
            <Style x:Key="SummaryValueStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="22"/>
                <Setter Property="FontFamily"
                        Value="Consolas"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="TableHeaderTextStyle"
                   TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                Margin="22,0"
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="WORKTRAIL" />
        </Grid>

        <Grid
            x:Name="DialogBody"
            Grid.Row="1"
            Padding="26,8,26,24"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Foreground="#FF7D9FF8"
                    Glyph="&#xE9D2;"/>
                <StackPanel
                    Grid.Column="1"
                    Spacing="3">
                    <TextBlock
                        x:Name="DialogTitleText"
                        AutomationProperties.LiveSetting="Assertive"
                        FontSize="22"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="DialogSubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="20"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="10"
                RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,4,0,4" Spacing="4">
                    <TextBlock x:Name="EstimatedTodayLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock x:Name="EstimatedTodayValue" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,4,0,4" Spacing="4">
                    <TextBlock x:Name="EstimatedRequestsLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock x:Name="EstimatedRequestsValue" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,4,0,4" Spacing="4">
                    <TextBlock x:Name="TodayTokensLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock x:Name="TodayTokensValue" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,4,0,4" Spacing="4">
                    <TextBlock x:Name="LastSyncLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock x:Name="LastSyncValue" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Spacing="4">
                    <TextBlock x:Name="DisplayedModelsLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock x:Name="DisplayedModelsValue" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,4" Spacing="4">
                    <TextBlock x:Name="ReportedCostLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock x:Name="ReportedCostValue" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="2"
                Background="{ThemeResource SurfacePanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="16,0"
                        ColumnSpacing="12"
                        Background="{ThemeResource SurfaceChipBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ModelHeaderText"
                            VerticalAlignment="Center"
                            Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock
                            x:Name="InputHeaderText"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock
                            x:Name="OutputHeaderText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource TableHeaderTextStyle}" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel x:Name="PricingRowsPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="CloseButton"
                    MinWidth="96"
                    Click="CloseButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
