<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkTrail.QuickSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTrail Quick Setup">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <SolidColorBrush x:Key="QuickSetupAccentBrush" Color="#FF2D9CDB" />
            <SolidColorBrush x:Key="QuickSetupAccentPointerBrush" Color="#FF3AABE8" />
            <SolidColorBrush x:Key="QuickSetupAccentPressedBrush" Color="#FF1987C7" />
            <SolidColorBrush x:Key="QuickSetupAccentSubtleBrush" Color="#262D9CDB" />
            <SolidColorBrush x:Key="QuickSetupSelectedFillBrush" Color="#102D9CDB" />

            <Style x:Key="ProfileCardToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="158" />
                <Setter Property="Padding" Value="20,17" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border
                                    x:Name="CardRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                    <ContentPresenter
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <FontIcon
                                    x:Name="CheckGlyph"
                                    Margin="0,14,14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="17"
                                    Foreground="{StaticResource QuickSetupAccentBrush}"
                                    Glyph="&#xE73E;"
                                    Visibility="Collapsed" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="CardRoot.Opacity" Value="0.48" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CardRoot.Background" Value="{StaticResource QuickSetupSelectedFillBrush}" />
                                                <Setter Target="CardRoot.BorderBrush" Value="{StaticResource QuickSetupAccentBrush}" />
                                                <Setter Target="CardRoot.BorderThickness" Value="1" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ProfileFeatureTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="QuickSetupPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource QuickSetupAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border
                                    x:Name="PrimaryButtonRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButtonRoot.Background" Value="{StaticResource QuickSetupAccentPointerBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButtonRoot.Background" Value="{StaticResource QuickSetupAccentPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButtonRoot.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuickSetupCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="CheckBoxRoot"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <FontIcon
                                        x:Name="CheckBoxGlyph"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="13"
                                        Foreground="White"
                                        Glyph="&#xE73E;"
                                        Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="CheckBoxRoot.BorderBrush" Value="{StaticResource QuickSetupAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="CheckBoxRoot.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CheckBoxRoot.Background" Value="{StaticResource QuickSetupAccentBrush}" />
                                                <Setter Target="CheckBoxRoot.BorderBrush" Value="{StaticResource QuickSetupAccentBrush}" />
                                                <Setter Target="CheckBoxGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Margin="24,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <Image
                    x:Name="TitleBarBrandMark"
                    Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    CharacterSpacing="90"
                    Style="{StaticResource WorkTrailTitleBarLabelStyle}"
                    Text="WORKTRAIL" />
            </StackPanel>
            <Rectangle
                Grid.ColumnSpan="4"
                Height="1"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <Grid x:Name="ProfileSurface" Grid.Row="1" Padding="28,14,28,18" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="WelcomeText"
                    Tag="QuickSetup.Eyebrow"
                    CharacterSpacing="80"
                    FontSize="12"
                    Opacity="0.64"
                    Text="INITIAL SETUP" />
                <TextBlock
                    Tag="QuickSetup.Heading"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="Choose your privacy level"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Tag="QuickSetup.Subtitle"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Four ready-to-use profiles. You can change your mind at any time."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,20,0,0"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ToggleButton
                        x:Name="CompleteProfileButton"
                        Tag="complete"
                        Click="ProfileButton_Click"
                        IsChecked="True"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw">
                                <Grid Width="48" Height="48">
                                    <Path Data="M24,3 L41,10 L41,22 C41,33 34,41 24,45 C14,41 7,33 7,22 L7,10 Z" Fill="Transparent" Stroke="{StaticResource QuickSetupAccentBrush}" StrokeLineJoin="Round" StrokeThickness="2.5" />
                                    <Path Data="M15,24 L21,30 L34,17" Stroke="{StaticResource QuickSetupAccentBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2.5" />
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Tag="QuickSetup.Profile.Complete.Title" FontSize="20" FontWeight="SemiBold" Text="Complete" />
                                    <Border
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource QuickSetupAccentSubtleBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            Tag="QuickSetup.Recommended"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource QuickSetupAccentBrush}"
                                            Text="RECOMMENDED" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Tag="QuickSetup.Profile.Complete.Subtitle"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="All features available"
                                    TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Ai" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features" />
                                    </Grid>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Screenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="Automatic screenshots" />
                                    </Grid>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NetworkWhenNeeded" Style="{StaticResource ProfileFeatureTextStyle}" Text="Connection when needed" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="AssistedProfileButton"
                        Tag="assisted"
                        Grid.Column="1"
                        Click="ProfileButton_Click"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                <Grid Width="48" Height="48">
                                    <Path Data="M24,9 C21,5 15,5 12,9 C8,9 6,12 6,16 C3,19 4,24 7,27 C4,31 6,37 11,38 C13,43 20,43 24,39 Z" Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeLineJoin="Round" StrokeThickness="2.4" />
                                    <Path Data="M24,9 C27,5 33,5 36,9 C40,9 42,12 42,16 C45,19 44,24 41,27 C44,31 42,37 37,38 C35,43 28,43 24,39 Z" Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeLineJoin="Round" StrokeThickness="2.4" />
                                    <Path Data="M24,9 L24,39 M13,17 C17,17 19,19 19,22 M35,17 C31,17 29,19 29,22 M11,29 C15,29 18,31 18,35 M37,29 C33,29 30,31 30,35" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="2.2" />
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Tag="QuickSetup.Profile.Assisted.Title" FontSize="20" FontWeight="SemiBold" Text="Assisted" />
                                <TextBlock Tag="QuickSetup.Profile.Assisted.Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="AI without recording the screen" TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Ai" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoScreenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="No screenshots" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NetworkWhenNeeded" Style="{StaticResource ProfileFeatureTextStyle}" Text="Connection when needed" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="LocalRecordProfileButton"
                        Tag="local-record"
                        Grid.Row="1"
                        Click="ProfileButton_Click"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                <Grid Width="48" Height="48">
                                    <Path Data="M9,7 L39,7 L45,34 C46,39 43,42 38,42 L10,42 C5,42 2,39 3,34 Z" Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeLineJoin="Round" StrokeThickness="2.5" />
                                    <Path Data="M4,33 L44,33" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="2.2" />
                                    <Ellipse Width="3.5" Height="3.5" Margin="0,0,8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Tag="QuickSetup.Profile.LocalRecord.Title" FontSize="20" FontWeight="SemiBold" Text="Local record" />
                                <TextBlock Tag="QuickSetup.Profile.LocalRecord.Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="A visual history only on this PC" TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoAi" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features disabled" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Screenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="Automatic screenshots" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.AlwaysOffline" Style="{StaticResource ProfileFeatureTextStyle}" Text="Always offline" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="EssentialOfflineProfileButton"
                        Tag="essential-offline"
                        Grid.Row="1"
                        Grid.Column="1"
                        Click="ProfileButton_Click"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                <Grid Width="48" Height="48">
                                    <Path Data="M11,35 L36,35 C41,35 44,32 44,27 C44,23 41,20 37,19 C36,12 31,8 25,8 C20,8 17,11 15,15 C9,15 5,19 5,25 C5,30 8,33 11,35" Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2.5" />
                                    <Path Data="M6,6 L42,42" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="2.8" />
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Tag="QuickSetup.Profile.EssentialOffline.Title" FontSize="20" FontWeight="SemiBold" Text="Essential offline" />
                                <TextBlock Tag="QuickSetup.Profile.EssentialOffline.Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The minimum to get started" TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoAi" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features disabled" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoScreenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="No screenshots" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.AlwaysOffline" Style="{StaticResource ProfileFeatureTextStyle}" Text="Always offline" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                </Grid>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Margin="0,16,0,0"
                Padding="14,12"
                Background="{StaticResource QuickSetupAccentSubtleBrush}"
                BorderBrush="{StaticResource QuickSetupAccentBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="SelectedProfileLabelText" FontWeight="SemiBold" Text="Selected profile:" />
                        <TextBlock x:Name="SelectedProfileNameText" FontWeight="SemiBold" Foreground="{StaticResource QuickSetupAccentBrush}" Text="Complete" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SelectedProfileDescriptionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="AI and screenshots enabled. Content is sent to the AI provider only when an AI feature is used."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="ApplyInfoBar"
                Grid.Row="3"
                Margin="0,12,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Rectangle Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="StartWithWindowsCheckBox"
                        Tag="QuickSetup.StartWithWindows"
                        VerticalAlignment="Center"
                        Content="Start WorkTrail when I sign in to Windows"
                        Style="{StaticResource QuickSetupCheckBoxStyle}" />
                    <Button
                        x:Name="ApiSetupButton"
                        Grid.Column="1"
                        Tag="ProviderSetup.ApiButton"
                        Width="180"
                        Height="42"
                        Padding="12,6"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="OpenAI API"
                        Click="ApiSetupButton_Click" />
                    <Button
                        x:Name="PrimaryButton"
                        Grid.Column="2"
                        Width="180"
                        Height="42"
                        Click="PrimaryButton_Click"
                        Content="Start"
                        Style="{StaticResource QuickSetupPrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>
        <ContentControl x:Name="KeySetupHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
