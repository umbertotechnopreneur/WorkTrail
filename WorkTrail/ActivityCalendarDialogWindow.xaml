<Window
    x:Class="WorkTrail.ActivityCalendarDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:WorkTrail.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTrail">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="ActivityHeatOne" Color="#244A73" />
                        <SolidColorBrush x:Key="ActivityHeatTwo" Color="#206B82" />
                        <SolidColorBrush x:Key="ActivityHeatThree" Color="#957219" />
                        <SolidColorBrush x:Key="ActivityHeatFour" Color="#A85520" />
                        <SolidColorBrush x:Key="ActivityHeatFive" Color="#B54A2B" />
                        <SolidColorBrush x:Key="ActivityHeatForeground" Color="White" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ActivityHeatOne" Color="#D6E6FA" />
                        <SolidColorBrush x:Key="ActivityHeatTwo" Color="#B9E1EB" />
                        <SolidColorBrush x:Key="ActivityHeatThree" Color="#F4DEA1" />
                        <SolidColorBrush x:Key="ActivityHeatFour" Color="#F7CFAD" />
                        <SolidColorBrush x:Key="ActivityHeatFive" Color="#F5C4B3" />
                        <SolidColorBrush x:Key="ActivityHeatForeground" Color="#161616" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ActivityHeatOne" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        <SolidColorBrush x:Key="ActivityHeatTwo" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        <SolidColorBrush x:Key="ActivityHeatThree" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        <SolidColorBrush x:Key="ActivityHeatFour" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        <SolidColorBrush x:Key="ActivityHeatFive" Color="{ThemeResource SystemColorButtonFaceColor}" />
                        <SolidColorBrush x:Key="ActivityHeatForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                Margin="22,0"
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="WORKTRAIL" />
            <Button
                x:Name="TitleBarCloseButton"
                Grid.Column="2"
                Width="48"
                Height="44"
                AutomationProperties.Name="Close"
                ToolTipService.ToolTip="Close"
                Click="CloseButton_Click"
                Style="{StaticResource WorkTrailTitleBarCommandButtonStyle}">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid x:Name="DialogBody" Grid.Row="1" Padding="24,8,24,18" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Name="DialogTitleText" FontSize="23" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="DialogSubtitleText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <TabView x:Name="ActivityTabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                         TabWidthMode="Equal" SelectionChanged="ActivityTabs_SelectionChanged" Visibility="Collapsed"
                         VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabViewItem x:Name="CalendarTab" IsClosable="False">
                        <TabViewItem.IconSource><SymbolIconSource Symbol="Calendar" /></TabViewItem.IconSource>
                            <Grid x:Name="CalendarPanel" RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Button x:Name="TodayButton" HorizontalAlignment="Right" Click="TodayButton_Click" />
                                <Grid Grid.Row="1" SizeChanged="CalendarPanel_SizeChanged">
                                    <CalendarView
                                        x:Name="ActivityCalendarView"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        MinHeight="0"
                                        FirstDayOfWeek="Monday"
                                        AutomationProperties.Name="Activity calendar"
                                        CalendarViewDayItemChanging="ActivityCalendarView_CalendarViewDayItemChanging"
                                        CalendarItemCornerRadius="4"
                                        BlackoutStrikethroughBrush="Transparent"
                                        BlackoutForeground="{ThemeResource TextFillColorTertiaryBrush}"
                                        SelectedBorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        CalendarItemForeground="{ThemeResource ActivityHeatForeground}"
                                        OutOfScopeForeground="{ThemeResource ActivityHeatForeground}"
                                        OutOfScopeHoverForeground="{ThemeResource ActivityHeatForeground}"
                                        OutOfScopePressedForeground="{ThemeResource ActivityHeatForeground}"
                                        PressedForeground="{ThemeResource ActivityHeatForeground}"
                                        SelectedForeground="{ThemeResource ActivityHeatForeground}"
                                        SelectedHoverForeground="{ThemeResource ActivityHeatForeground}"
                                        SelectedPressedForeground="{ThemeResource ActivityHeatForeground}"
                                        TodayBackground="Transparent"
                                        TodayHoverBackground="Transparent"
                                        TodayPressedBackground="Transparent"
                                        TodayForeground="{ThemeResource ActivityHeatForeground}"
                                        DoubleTapped="ActivityCalendarView_DoubleTapped"
                                        IsGroupLabelVisible="True"
                                        IsDoubleTapEnabled="True"
                                        IsOutOfScopeEnabled="False"
                                        IsTodayHighlighted="True"
                                        NumberOfWeeksInView="6"
                                        SelectedDatesChanged="ActivityCalendarView_SelectedDatesChanged"
                                        SelectionMode="Single">
                                        <CalendarView.CalendarViewDayItemStyle>
                                            <Style TargetType="CalendarViewDayItem">
                                                <Setter Property="Margin" Value="2" />
                                                <Setter Property="MinHeight" Value="20" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarViewDayItem">
                                                            <ContentPresenter Content="{TemplateBinding Tag}"
                                                                              IsHitTestVisible="False"
                                                                              HorizontalContentAlignment="Stretch"
                                                                              VerticalContentAlignment="Stretch" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </CalendarView.CalendarViewDayItemStyle>
                                    </CalendarView>
                                </Grid>
                            </Grid>
                    </TabViewItem>
                    <TabViewItem x:Name="WeekTab" IsClosable="False">
                        <TabViewItem.IconSource><SymbolIconSource Symbol="View" /></TabViewItem.IconSource>
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="PreviousWeekButton" AutomationProperties.Name="Previous week" ToolTipService.ToolTip="Previous week" Click="PreviousWeekButton_Click"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                                <TextBlock x:Name="WeekRangeText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <Button x:Name="NextWeekButton" Grid.Column="2" AutomationProperties.Name="Next week" ToolTipService.ToolTip="Next week" Click="NextWeekButton_Click"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                                <Button x:Name="CurrentWeekButton" Grid.Column="3" Click="CurrentWeekButton_Click" />
                            </Grid>
                            <controls:ActivityWeekHeatmap x:Name="WeekHeatmap" Grid.Row="1" />
                            <StackPanel x:Name="WeekStatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                                <ProgressRing x:Name="WeekLoadingRing" Width="28" Height="28" />
                                <TextBlock x:Name="WeekStatusText" TextWrapping="WrapWholeWords" MaxWidth="360" />
                                <Button x:Name="WeekRetryButton" Click="WeekRetryButton_Click" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </TabViewItem>
                </TabView>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <Border
                        x:Name="DayDetailsBorder"
                        Padding="22,8,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                x:Name="SelectedDateText"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="DayStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="20"
                                TextWrapping="WrapWholeWords" />

                            <StackPanel
                                x:Name="DayMetricsPanel"
                                Spacing="10"
                                Visibility="Collapsed">
                                <StackPanel Spacing="7">
                                    <TextBlock
                                        x:Name="ScoreLabelText"
                                        CharacterSpacing="90"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <TextBlock
                                            x:Name="ScoreValueText"
                                            FontFamily="Consolas"
                                            FontSize="38"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,7"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="16"
                                            Text="/ 100" />
                                    </StackPanel>
                                    <ProgressBar
                                        x:Name="ScoreProgressBar"
                                        Height="4"
                                        Maximum="100"
                                        Minimum="0" />
                                </StackPanel>

                                <Border
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0" />

                                <Grid
                                    ColumnSpacing="12"
                                    RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="ActiveTimeLabelText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ActiveTimeValueText" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <TextBlock x:Name="IdleTimeLabelText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="IdleTimeValueText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TrackedTimeLabelText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TrackedTimeValueText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <TextBlock x:Name="KeyPressesLabelText" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="KeyPressesValueText" Grid.Row="3" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MouseClicksLabelText" Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MouseClicksValueText" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SamplesLabelText" Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SamplesValueText" Grid.Row="5" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                </Grid>

                                <StackPanel
                                    x:Name="InstallationLegendSection"
                                    Spacing="7">
                                    <TextBlock
                                        x:Name="InstallationLegendTitleText"
                                        CharacterSpacing="90"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold" />
                                    <ScrollViewer
                                        MaxHeight="112"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="InstallationLegendItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="0,2,0,5"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        ColumnSpacing="9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="24"
                                                            Height="24"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="12">
                                                            <FontIcon
                                                                AutomationProperties.AccessibilityView="Raw"
                                                                FontFamily="Segoe Fluent Icons"
                                                                FontSize="12"
                                                                Foreground="White"
                                                                Glyph="{Binding IconGlyph}" />
                                                        </Border>
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="0">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding FriendlyName}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                FontSize="11"
                                                                Text="{Binding MachineName}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding Visibility, ElementName=ReprocessAiButton}" />

                            <Button
                                x:Name="ReprocessAiButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="ReprocessAiButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE895;" />
                                    <TextBlock
                                        x:Name="ReprocessAiButtonText"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </ScrollViewer>
                <StackPanel x:Name="StatusPanel" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="12">
                    <ProgressRing x:Name="LoadingRing" Width="34" Height="34" IsActive="True" />
                    <FontIcon x:Name="StatusIcon" Glyph="&#xEA39;" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="StatusText" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="HeatNoData" Width="16" Height="16" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NoDataLegendText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Margin="0,0,0,5" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeatLevelOne" Background="{ThemeResource ActivityHeatOne}" CornerRadius="4" Padding="2,5">
                            <TextBlock Text="0–19" Foreground="{ThemeResource ActivityHeatForeground}" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="HeatLevelTwo" Grid.Column="1" Background="{ThemeResource ActivityHeatTwo}" CornerRadius="4" Padding="2,5">
                            <TextBlock Text="20–39" Foreground="{ThemeResource ActivityHeatForeground}" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="HeatLevelThree" Grid.Column="2" Background="{ThemeResource ActivityHeatThree}" CornerRadius="4" Padding="2,5">
                            <TextBlock Text="40–59" Foreground="{ThemeResource ActivityHeatForeground}" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="HeatLevelFour" Grid.Column="3" Background="{ThemeResource ActivityHeatFour}" CornerRadius="4" Padding="2,5">
                            <TextBlock Text="60–79" Foreground="{ThemeResource ActivityHeatForeground}" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="HeatLevelFive" Grid.Column="4" Background="{ThemeResource ActivityHeatFive}" CornerRadius="4" Padding="2,5">
                            <TextBlock Text="80–100" Foreground="{ThemeResource ActivityHeatForeground}" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CalendarLegendText" FontSize="12" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CalendarHintText" FontSize="11" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" MinWidth="96" VerticalAlignment="Bottom" Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
