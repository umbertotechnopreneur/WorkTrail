<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkTrail.CelestialWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkTrail"
    xmlns:controls="using:WorkTrail.Controls">
    <Window.SystemBackdrop>
        <local:GlassBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="PrimaryPalette" Background="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <Border x:Name="SecondaryPalette" Background="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        <Border x:Name="AccentPalette" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <Border x:Name="DividerPalette" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />
        <Border x:Name="CardPalette" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed" />
        <Grid x:Name="TitleBarDragRegion"
              Background="{ThemeResource WorkTrailTitleBarOverlayBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarLogo" Grid.Column="1" Margin="16,0,10,0"
                   Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
            <TextBlock x:Name="TitleBarText" Grid.Column="2" Margin="0,0,12,0" CharacterSpacing="70"
                       Style="{StaticResource WorkTrailTitleBarLabelStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="20,8,20,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Toolbar" Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CitySelector" DisplayMemberPath="CityName" SelectedValuePath="CityId"
                          MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                          FontWeight="Light" SelectionChanged="CitySelector_SelectionChanged" />
                <ToggleSwitch x:Name="PlanetsVisibilitySwitch" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                              IsOn="True" Toggled="SkyVisibilitySwitch_Toggled" />
                <ToggleSwitch x:Name="ConstellationsVisibilitySwitch" Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                              IsOn="True" Toggled="SkyVisibilitySwitch_Toggled" />
                <Button x:Name="AgendaOptionsButton" Grid.Column="3" Width="38" Height="38"
                        Visibility="Collapsed" Click="AgendaOptionsButton_Click"
                        AutomationProperties.Name="Agenda options" ToolTipService.ToolTip="Agenda options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <TextBlock x:Name="StatusText" Grid.Column="4" FontSize="12" FontWeight="Light"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid x:Name="SurfaceGrid" Grid.Row="0">
                <controls:LocalSkyControl x:Name="SkyControl" Visibility="Collapsed" />
                <controls:CelestialMapControl x:Name="EarthControl" Visibility="Collapsed" />
                <ScrollViewer x:Name="AgendaScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="AgendaRows" Spacing="10" Margin="0,0,6,0" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="18" FontWeight="Light" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
            <StackPanel x:Name="Footer" Grid.Row="1" Spacing="6">
                <Border x:Name="BodiesFrame" CornerRadius="18" BorderThickness="1" Padding="14,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="AboveHorizonText" FontSize="14" FontWeight="Light" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <RepeatButton x:Name="PreviousBodiesButton" Width="32" Height="44" VerticalAlignment="Center" IsEnabled="False"
                                          Click="PreviousBodiesButton_Click" Delay="350" Interval="150">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                            </RepeatButton>
                        <ScrollViewer x:Name="BodiesScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled" ViewChanged="BodiesScroll_ViewChanged" SizeChanged="BodiesScroll_SizeChanged">
                            <StackPanel x:Name="BodyItems" Orientation="Horizontal" Spacing="22" SizeChanged="BodiesScroll_SizeChanged" />
                        </ScrollViewer>
                            <RepeatButton x:Name="NextBodiesButton" Grid.Column="2" Width="32" Height="44" VerticalAlignment="Center" IsEnabled="False"
                                          Click="NextBodiesButton_Click" Delay="350" Interval="150">
                                <FontIcon Glyph="&#xE76C;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                            </RepeatButton>
                        </Grid>
                    </StackPanel>
                </Border>
                <Expander x:Name="ZodiacExpander" Visibility="Collapsed" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="CurrentZodiacImage" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ZodiacSummaryText" Grid.Column="1" FontWeight="Light" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Expander.Header>
                    <ScrollViewer x:Name="ZodiacContentScroll" MaxHeight="220" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                        <ScrollViewer HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ZodiacItems" Orientation="Horizontal" Spacing="10" />
                        </ScrollViewer>
                        <TextBlock x:Name="ZodiacNoteText" FontSize="12" FontWeight="Light" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Grid>
        <ProgressRing x:Name="LoadingIndicator" Grid.Row="1" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="True" />
        <controls:TimedInfoBar x:Name="NotificationBanner" Grid.Row="1" Margin="16"
                              HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Canvas.ZIndex="100" />
    </Grid>
</Window>
