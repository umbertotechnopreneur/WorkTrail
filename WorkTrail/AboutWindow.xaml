<Window
    x:Class="WorkTrail.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About WorkTrail">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsDividerColumn.Width" Value="0" />
                        <Setter Target="DiagnosticsColumn.Width" Value="0" />
                        <Setter Target="DetailsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="DetailsDivider.Visibility" Value="Collapsed" />
                        <Setter Target="DiagnosticsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="DiagnosticsPanel.Margin" Value="0,18,0,0" />
                        <Setter Target="LegalLinksPanel.(Grid.Column)" Value="0" />
                        <Setter Target="LegalLinksPanel.(Grid.Row)" Value="1" />
                        <Setter Target="LegalLinksPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="LegalLinksPanel.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="1"
                Margin="16,0,0,0"
                Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,12,0"
                AutomationProperties.AccessibilityView="Raw"
                CharacterSpacing="90"
                Style="{StaticResource WorkTrailTitleBarLabelStyle}"
                Text="WORKTRAIL" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Height="160">
                        <Grid.Background>
                            <ImageBrush
                                ImageSource="ms-appx:///Assets/WorkTrailAboutHeroTrailV1.png"
                                AlignmentX="Center"
                                AlignmentY="Center"
                                Stretch="UniformToFill" />
                        </Grid.Background>
                        <TextBlock
                            Margin="24,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Foreground="#FFF7ED"
                            Text="WorkTrail" />
                    </Grid>

                    <Grid x:Name="DetailsGrid" Margin="24,18,24,16" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*" />
                            <ColumnDefinition x:Name="DetailsDividerColumn" Width="1" />
                            <ColumnDefinition x:Name="DiagnosticsColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <TextBlock
                                Tag="About.Description"
                                FontSize="15"
                                Opacity="0.82"
                                Text="Retrace your day, find past desktop activity, and pick up where you left off."
                                TextWrapping="WrapWholeWords" />

                            <Grid ColumnSpacing="18" RowSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Tag="About.Version" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Version" />
                                <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />

                                <TextBlock Grid.Row="1" Tag="About.Built" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Built" />
                                <TextBlock x:Name="BuiltAtText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />

                                <TextBlock Grid.Row="2" Tag="About.Commit" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Git commit" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="CommitText" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                                    <TextBlock
                                        x:Name="DirtyIndicator"
                                        Tag="About.Dirty"
                                        Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="uncommitted changes"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <Button
                                x:Name="LicensesButton"
                                Tag="About.ThirdPartyLicenses"
                                HorizontalAlignment="Left"
                                Padding="0,5"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Click="LicensesButton_Click"
                                Content="Third-party licenses" />
                        </StackPanel>

                        <Rectangle
                            x:Name="DetailsDivider"
                            Grid.Column="1"
                            Width="1"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel x:Name="DiagnosticsPanel" Grid.Column="2" Spacing="10">
                            <StackPanel Spacing="5">
                                <TextBlock Tag="About.Diagnostics" FontSize="17" FontWeight="SemiBold" Text="Diagnostics" />
                                <TextBlock
                                    Tag="About.Diagnostics.Description"
                                    Opacity="0.72"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Open the current log, or share a bounded copy with private paths and secrets removed."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="ShowLogButton"
                                    Tag="About.ShowLogs"
                                    MinHeight="34"
                                    HorizontalContentAlignment="Center"
                                    Click="ShowLogButton_Click"
                                    Content="View logs" />
                                <Button
                                    x:Name="ShareLogButton"
                                    Tag="About.ShareLog"
                                    Grid.Column="1"
                                    MinHeight="34"
                                    HorizontalContentAlignment="Center"
                                    Click="ShareLogButton_Click"
                                    Content="Share log" />
                            </Grid>
                            <InfoBar
                                x:Name="DiagnosticsInfoBar"
                                IsClosable="True"
                                IsOpen="False"
                                Severity="Informational" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="24,0,24,18" ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Rectangle
                    Grid.ColumnSpan="2"
                    Height="1"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Width="48" Height="48" AutomationProperties.Name="VibeWare" Stretch="Uniform">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="192" UriSource="ms-appx:///Assets/VibeWareLogo.png" />
                        </Image.Source>
                    </Image>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="VibeWare" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="VibeWareAboutButton"
                                Tag="About.VibeWare.WhatIs"
                                Padding="0,2"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Click="VibeWareAboutButton_Click"
                                Content="What is VibeWare?" />
                            <Button
                                x:Name="VibeWareManifestoButton"
                                Tag="About.VibeWare.Manifesto"
                                Padding="0,2"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Click="VibeWareManifestoButton_Click"
                                Content="Manifesto" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="18" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Tag="About.CreatedBy" VerticalAlignment="Center" Opacity="0.62" FontSize="12" Text="Created by" />
                        <Button
                            x:Name="CreatedByButton"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Click="WebsiteButton_Click"
                            Content="umbertogiacobbi.biz" />
                    </StackPanel>
                    <StackPanel x:Name="LegalLinksPanel" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="RepositoryButton"
                            Tag="About.Repository"
                            Padding="0,5"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Click="RepositoryButton_Click"
                            Content="GitHub repository" />
                        <Button
                            x:Name="PrivacyButton"
                            Tag="About.Privacy"
                            Padding="0,5"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Click="PrivacyButton_Click"
                            Content="Privacy" />
                        <Button
                            x:Name="TermsButton"
                            Tag="About.Terms"
                            Padding="0,5"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Click="TermsButton_Click"
                            Content="Terms" />
                    </StackPanel>
                </Grid>
                <Button
                    x:Name="CloseButton"
                    Tag="About.Close"
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="96"
                    MinHeight="34"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    Content="Close"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
