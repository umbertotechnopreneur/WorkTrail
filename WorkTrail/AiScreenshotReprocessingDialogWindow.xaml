<Window
    x:Class="WorkTrail.AiScreenshotReprocessingDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI screenshot reprocessing">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Margin="24,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="15"
                    Glyph="&#xE895;" />
                <TextBlock
                    VerticalAlignment="Center"
                    CharacterSpacing="80"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Tag="AiReprocess.Eyebrow"
                    Text="AI REPROCESSING" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Padding="30,18,30,24"
                RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Width="38"
                        Height="38"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="#FF7D9FF8"
                        Glyph="&#xE9D9;" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            x:Name="DialogTitleText"
                            AutomationProperties.LiveSetting="Assertive"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Tag="AiReprocess.Title"
                            Text="Reprocess screenshots"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="DialogSubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="20"
                            Tag="AiReprocess.Subtitle"
                            Text="Create missing AI descriptions from retained screenshots."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel
                        x:Name="PreflightPanel"
                        Spacing="20">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="AiReprocess.Date"
                                Text="Date" />
                            <TextBlock
                                x:Name="SelectedDateValueText"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="AiReprocess.Provider"
                                Text="AI provider" />
                            <TextBlock
                                x:Name="ProviderModelValueText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,6,0,0"
                                FontFamily="Cascadia Mono"
                                IsTextSelectionEnabled="True" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="5">
                            <TextBlock
                                x:Name="PreflightStateText"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Tag="AiReprocess.Loading"
                                Text="Preparing an exact preview"
                                TextWrapping="WrapWholeWords" />
                            <ProgressBar
                                x:Name="PreflightProgressBar"
                                Height="3"
                                IsIndeterminate="True" />
                        </StackPanel>

                        <Grid
                            x:Name="PreflightCountsGrid"
                            ColumnSpacing="24"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="MissingScreenshotsValueText"
                                    FontFamily="Cascadia Mono"
                                    FontSize="38"
                                    FontWeight="SemiBold"
                                    Text="0" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Tag="AiReprocess.Screenshots"
                                    Text="screenshots without descriptions"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    x:Name="MissingCapturesValueText"
                                    FontFamily="Cascadia Mono"
                                    FontSize="38"
                                    FontWeight="SemiBold"
                                    Text="0" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Tag="AiReprocess.Captures"
                                    Text="captures"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock
                                    x:Name="MaximumRequestsValueText"
                                    FontFamily="Cascadia Mono"
                                    FontSize="38"
                                    FontWeight="SemiBold"
                                    Text="0" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Tag="AiReprocess.Requests"
                                    Text="maximum AI requests"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>

                        <Grid
                            x:Name="PreflightBreakdownGrid"
                            RowSpacing="10"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="EligibleBreakdownText"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="ExcludedBreakdownText"
                                Grid.Row="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="QuotaBreakdownText"
                                Grid.Row="2"
                                FontWeight="SemiBold"
                                TextWrapping="WrapWholeWords" />
                        </Grid>

                        <TextBlock
                            x:Name="BlockingReasonText"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel
                        x:Name="ProgressPanel"
                        Spacing="20"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="JobStateText"
                                AutomationProperties.LiveSetting="Assertive"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="JobDateText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                            <ProgressBar
                                x:Name="JobProgressBar"
                                Height="6"
                                IsIndeterminate="False"
                                Maximum="1"
                                Minimum="0"
                                Value="0" />
                        </StackPanel>

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="7">
                                <TextBlock
                                    CharacterSpacing="70"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Tag="AiReprocess.Captures"
                                    Text="CAPTURES" />
                                <TextBlock x:Name="CompletedCapturesText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="RemainingCapturesText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="SucceededCapturesText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="SkippedCapturesText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="FailedCapturesText" FontFamily="Cascadia Mono" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock
                                    CharacterSpacing="70"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Tag="AiReprocess.Screenshots"
                                    Text="SCREENSHOTS" />
                                <TextBlock x:Name="CompletedScreenshotsText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="RemainingScreenshotsText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="SucceededScreenshotsText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="SkippedScreenshotsText" FontFamily="Cascadia Mono" />
                                <TextBlock x:Name="FailedScreenshotsText" FontFamily="Cascadia Mono" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="7">
                            <TextBlock
                                FontWeight="SemiBold"
                                Tag="AiReprocess.CurrentItemLabel"
                                Text="Current item" />
                            <TextBlock
                                x:Name="CurrentItemText"
                                IsTextSelectionEnabled="True"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TextBlock
                            x:Name="CloseKeepsRunningText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Tag="AiReprocess.CloseKeepsRunning"
                            Text="Closing this window does not stop the background job."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Height="1"
            VerticalAlignment="Top"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Grid
            Grid.Row="2"
            Padding="30,14,30,22"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    x:Name="OperationProgressRing"
                    Width="18"
                    Height="18"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="OperationStatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="PauseResumeButton"
                Grid.Column="1"
                MinWidth="112"
                Click="PauseResumeButton_Click"
                Content="Pause"
                Tag="AiReprocess.Pause"
                Visibility="Collapsed" />
            <Button
                x:Name="StartButton"
                Grid.Column="2"
                MinWidth="148"
                Click="StartButton_Click"
                Content="Start"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CloseButton"
                Grid.Column="3"
                MinWidth="96"
                Click="CloseButton_Click"
                Content="Close"
                Tag="AiReprocess.Close" />
        </Grid>
    </Grid>
</Window>
