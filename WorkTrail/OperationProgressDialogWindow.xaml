<Window
    x:Class="WorkTrail.OperationProgressDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleDragRegion" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="1"
                Margin="16,0,0,0"
                Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
            <TextBlock
                x:Name="DialogTitleText"
                Grid.Column="2"
                Margin="10,0,12,0"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource WorkTrailTitleBarLabelStyle}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Padding="28,20,28,28" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="DescriptionText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="15"
                    LineHeight="22"
                    TextWrapping="WrapWholeWords" />
            </ScrollViewer>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock x:Name="PhaseText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="CountText" TextWrapping="Wrap" />
                <TextBlock x:Name="ElapsedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar
                x:Name="OperationProgress"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                IsIndeterminate="True" />
            <Button
                x:Name="CancelOperationButton"
                Grid.Row="3"
                MinWidth="110"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="OperationProgress.Cancel"
                Click="CancelOperationButton_Click" />
        </Grid>
    </Grid>
</Window>
