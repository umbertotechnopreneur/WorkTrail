<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WorkTrail.VipSnapshotCountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls" Title="VIP snapshot">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="16" Background="Transparent" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <controls:VipBadge x:Name="Badge" ShowText="False" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Tag="Snapshot.Vip.Take" Text="VIP snapshot" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Tag="Snapshot.Vip.CountdownIntro" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Tag="Snapshot.Vip.Description" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SecondsText" Text="5" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4" />
                <TextBlock Tag="Snapshot.Vip.CountdownHint" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="CancelButton" Grid.Row="1" Tag="Dialog.Cancel" Content="Cancel" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Click="CancelButton_Click" />
    </Grid>
</Window>
