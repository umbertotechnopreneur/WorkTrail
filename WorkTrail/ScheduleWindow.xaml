<Window
    x:Class="WorkTrail.ScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkTrail.Controls"
    Title="Snapshot schedule">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Margin="16,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image
                    Style="{StaticResource WorkTrailTitleBarLogoStyle}" />
                <TextBlock
                    CharacterSpacing="100"
                    FontSize="12"
                    Style="{StaticResource WorkTrailTitleBarLabelStyle}"
                    Tag="Schedule.WindowTitleUpper"
                    Text="SNAPSHOT SCHEDULE" />
                <controls:PremiumBadge x:Name="TitlePremiumBadge" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ScheduleBodyGrid"
            Grid.Row="1"
            MinHeight="0"
            MaxWidth="1240"
            Margin="24,14,24,12"
            HorizontalAlignment="Stretch"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ScheduleHeaderGrid" ColumnSpacing="18" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ScheduleWidthStates">
                        <VisualState x:Name="NarrowSchedule">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="WideSchedule">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="720" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HeaderIntervalColumn.Width" Value="Auto" />
                                <Setter Target="HeaderPresetColumn.Width" Value="Auto" />
                                <Setter Target="HeaderDescriptionColumn.Width" Value="*" />
                                <Setter Target="HeaderClearColumn.Width" Value="Auto" />
                                <Setter Target="IntervalPanel.(Grid.Row)" Value="0" />
                                <Setter Target="IntervalPanel.(Grid.Column)" Value="0" />
                                <Setter Target="IntervalPanel.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="PresetPanel.(Grid.Row)" Value="0" />
                                <Setter Target="PresetPanel.(Grid.Column)" Value="1" />
                                <Setter Target="PresetPanel.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="WorkingHoursDescription.(Grid.Row)" Value="0" />
                                <Setter Target="WorkingHoursDescription.(Grid.Column)" Value="2" />
                                <Setter Target="WorkingHoursDescription.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="ClearAllHoursButton.(Grid.Row)" Value="0" />
                                <Setter Target="ClearAllHoursButton.(Grid.Column)" Value="3" />
                                <Setter Target="ClearAllHoursButton.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderIntervalColumn" Width="*" />
                    <ColumnDefinition x:Name="HeaderPresetColumn" Width="*" />
                    <ColumnDefinition x:Name="HeaderDescriptionColumn" Width="0" />
                    <ColumnDefinition x:Name="HeaderClearColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="IntervalPanel" Grid.Row="0" Grid.Column="0" Spacing="5">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Tag="Schedule.Interval.Title" Text="Capture interval" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox
                            x:Name="IntervalNumberBox"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            Value="15"
                            Minimum="1"
                            Maximum="1440"
                            SmallChange="1"
                            LargeChange="5"
                            Tag="Schedule.Interval.Value"
                            SpinButtonPlacementMode="Compact" />
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="min" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="PresetPanel" Grid.Row="0" Grid.Column="1" Spacing="5">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Tag="Schedule.WorkingHours.Title" Text="Working hours" />
                    <Button
                        x:Name="StandardWorkWeekButton"
                        MinWidth="148"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Apply the 09:00-18:00 work week"
                        Click="StandardWorkWeekButton_Click"
                        Content="09:00-18:00"
                        Tag="Schedule.Preset.WorkWeek" />
                </StackPanel>
                <TextBlock
                    x:Name="WorkingHoursDescription"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Tag="Schedule.WorkingHours.Description"
                    Text="Select the 15-minute periods when scheduled snapshots may run."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="ClearAllHoursButton"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MinWidth="120"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Clear all working hours"
                    Click="ClearAllHoursButton_Click"
                    Content="Clear all"
                    Tag="Schedule.ClearAll" />
            </Grid>

            <controls:WeeklyHoursEditor
                x:Name="WorkingHoursEditor"
                Grid.Row="1"
                MinHeight="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Tag="Schedule.WorkingHours.CaptureNote"
                Text="When screen capture is enabled, an eligible snapshot also includes a screen capture."
                TextWrapping="Wrap" />
        </Grid>

        <Grid
            x:Name="ScheduleFooterGrid"
            Grid.Row="2"
            Padding="24,13,24,18"
            Background="Transparent"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.ColumnSpan="3"
                Height="1"
                Margin="-24,-13,-24,0"
                VerticalAlignment="Top"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button Grid.Column="1" MinWidth="112" Click="CancelButton_Click" Content="Cancel" Tag="Schedule.Cancel" />
            <Button
                Grid.Column="2"
                MinWidth="112"
                Click="SaveButton_Click"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}"
                Tag="Schedule.Save" />
        </Grid>
    </Grid>
</Window>
