<Window
    x:Class="WorkTrail.Taskbar.TaskbarWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTrail taskbar control"
    Width="288"
    Height="40"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="TaskbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="19">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#2FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Viewbox
            x:Name="WidgetViewbox"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <Grid Width="288" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="OpenFlyoutButton"
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Open WorkTrail"
                    Click="OpenFlyoutButton_Click"
                    Style="{StaticResource TaskbarButtonStyle}"
                    ToolTip="Open WorkTrail">
                    <Image
                        Width="22"
                        Height="22"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/WorkTrail.Taskbar;component/Assets/WorkTrailSquare44Logo.targetsize-24_altform-unplated.png" />
                </Button>
                <Button
                    x:Name="TrackingButton"
                    Grid.Column="1"
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start tracking"
                    Click="TrackingButton_Click"
                    Style="{StaticResource TaskbarButtonStyle}"
                    ToolTip="Start tracking">
                    <TextBlock
                        x:Name="PlayPauseIcon"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="17"
                        Foreground="#FFF4F5F1"
                        Text="&#xE768;" />
                </Button>
                <Grid
                    Grid.Column="2"
                    Margin="3,6"
                    VerticalAlignment="Stretch">
                    <Border
                        Background="#1FFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6" />
                    <TextBox
                        x:Name="SpanLabelTextBox"
                        MaxLength="20"
                        Padding="8,1"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Span label"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#FFF4F5F1"
                        TextChanged="SpanLabelTextBox_TextChanged"
                        ToolTip="Span label (max 20 characters)" />
                    <TextBlock
                        x:Name="SpanLabelWatermark"
                        Margin="9,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Foreground="#99F4F5F1"
                        Text="Span label" />
                </Grid>
                <Grid
                    x:Name="RecordingIndicator"
                    Grid.Column="3"
                    Width="40"
                    Height="38"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Activity recording is paused"
                    ToolTip="Activity recording is paused">
                    <Ellipse
                        x:Name="RecordingGlow"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#88FB4351"
                        Opacity="0" />
                    <Ellipse
                        x:Name="RecordingLed"
                        Width="9"
                        Height="9"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#FF77808D" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
