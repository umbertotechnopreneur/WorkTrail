  "microPrompts": {
    "code": "Focus on the visible file or project, concrete code changes or questions, and diagnostics. Describe what is shown, not an assumed edit history. Do not claim a build, save, commit or test succeeded without visible evidence.",
    "debugger": "Look for visible breakpoints, current execution position, call stack, exception messages and variable values. A matching title is only a hint: report a debugger state only if its controls or panels are visible. Do not invent values or infer the root cause from the title.",
    "sql": "Prioritize visible SQL statements, selected database or object, result columns, readable result values and errors. Distinguish an editor query from execution results. Do not infer database mutations, transaction commits or query success from the application name or title.",
    "terminal": "Read visible commands and their associated output, paths or project names, exit status and error messages when legible. Distinguish a typed command from an executed command and an old result from a current one. The terminal title alone is not evidence of execution or success. Do not reproduce secrets.",
    "collaboration": "Read visible discussion topics, questions, shared content and explicitly stated decisions. Distinguish proposals from decisions. A meeting window or idle grace is not proof of a live call, participation, spoken content or meeting duration.",
    "code-review": "Focus on visible issue or pull-request subject, diff, reviewer comments, checks and unresolved questions. A website name in the title is only a hint, not verified domain identity. Do not claim approval or merge unless visibly confirmed.",
    "work-items": "Identify visible task or customer-case subject, status, assignee and concrete next action when shown. Distinguish requested, in-progress and completed work. Never infer completion from the page title or app category.",
    "documents": "Read the visible document topic and substantive passages, table headings, formulas and meaningful figures. Distinguish visible content from assumptions about edits, authorship or saved state.",
    "design": "Describe the visible canvas, diagram relationships, selected component and discussion or annotation. Do not infer that a design was changed or approved from the tool name alone.",
    "dashboard": "Read visible metric labels, units, time range, filters, alert messages and error details. Distinguish a displayed historical incident from an ongoing failure; never invent causality or off-screen values.",
    "api": "Focus on the visible request method, non-secret endpoint context, status and response or error. Do not transcribe authentication headers, tokens or keys. A prepared request is not proof that it was sent.",
    "titles-only": "Read only the application or window title and its brief top-level state. Do not inspect, transcribe or summarize body content, messages, documents or media details. Do not infer inactivity or productivity from this low-attention classification."
  }
}
