<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WorkTrail</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\WorkTrail\Models\ActivityModels.cs" Link="Domain\ActivityModels.cs" />
    <Compile Include="..\WorkTrail\Providers\ActivityContextProviders.cs" Link="Infrastructure\ActivityContextProviders.cs" />
    <Compile Include="Infrastructure\Services\*.cs" />
    <Compile Include="Application\*.cs" />
    <Compile Include="Runtime\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="WorkTrail.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\meteor-showers.json" LogicalName="WorkTrail.Data.meteor-showers.json" />
    <EmbeddedResource Include="Data\sky-catalog.json" LogicalName="WorkTrail.Data.sky-catalog.json" />
    <EmbeddedResource Include="Data\sky-palette.json" LogicalName="WorkTrail.Data.sky-palette.json" />
    <EmbeddedResource Include="Data\important-dates.json" LogicalName="WorkTrail.Data.important-dates.json" />
    <EmbeddedResource Include="Data\celestial-calendar.json" LogicalName="WorkTrail.Data.celestial-calendar.json" />
    <EmbeddedResource Include="..\WorkTrail.Hardware\PawnIO\distribution.json" LogicalName="WorkTrail.PawnIO.distribution.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\prompts\*.prompt.md" Link="prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="search-synonyms.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="search-synonyms\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkTrail.Ocr\WorkTrail.Ocr.csproj" />
    <ProjectReference Include="..\WorkTrail.Search\WorkTrail.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.0" />
    <PackageReference Include="SGP.NET" Version="1.5.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>
</Project>
